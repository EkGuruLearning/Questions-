{"schema_version":1,"id":"series-12","subject_id":"reasoning","title":"Series practice — 12 questions","subject_title":"Reasoning","kind":"quiz","duration_minutes":12,"note":"Existing EkGuru sample questions, not a previous official exam. Mixed test Q6 is ungraded because its source relationship is ambiguous.","source":{"pdf":"content/reasoning/practice/Reasoning-Series-Sample-Practice.pdf","sha256":"8ec1aae169c14a8f103168ddb505999d0fc6bc76c02e452efae18bf4bf906ad8","label":"Existing repository practice material — not independently verified official key"},"questions":[{"id":"1","text":"5, 11, 23, 47, ? — agla number kya hoga?","type":"single","marks":1,"negative":0,"options":[{"id":"A","text":"94"},{"id":"B","text":"95"},{"id":"C","text":"96"},{"id":"D","text":"97"}],"answer":["B"],"explanation":"har baar ×2 + 1: 5 → 11 → 23 → 47 → 95."},{"id":"2","text":"7, 14, 28, 56, ? — series poora karo.","type":"single","marks":1,"negative":0,"options":[{"id":"A","text":"108"},{"id":"B","text":"112"},{"id":"C","text":"114"},{"id":"D","text":"120"}],"answer":["B"],"explanation":"har number pichle ka dugna: 56 × 2 = 112."},{"id":"3","text":"1, 4, 9, 16, 25, ? — agla number kya hoga?","type":"single","marks":1,"negative":0,"options":[{"id":"A","text":"30"},{"id":"B","text":"34"},{"id":"C","text":"36"},{"id":"D","text":"49"}],"answer":["C"],"explanation":"1², 2², 3², 4², 5², isliye agla 6² = 36."},{"id":"4","text":"2, 3, 5, 7, 11, ? — series ka agla pad kya hai?","type":"single","marks":1,"negative":0,"options":[{"id":"A","text":"12"},{"id":"B","text":"13"},{"id":"C","text":"14"},{"id":"D","text":"15"}],"answer":["B"],"explanation":"2, 3, 5, 7, 11 lagatar abhajya sankhyayen hain; 11 ke baad 13."},{"id":"5","text":"8, 27, 64, 125, ? — agla number kya hoga?","type":"single","marks":1,"negative":0,"options":[{"id":"A","text":"196"},{"id":"B","text":"206"},{"id":"C","text":"216"},{"id":"D","text":"226"}],"answer":["C"],"explanation":"2³, 3³, 4³, 5³, isliye agla 6³ = 216."},{"id":"6","text":"120, 60, 30, 15, ? — series poora karo.","type":"single","marks":1,"negative":0,"options":[{"id":"A","text":"5"},{"id":"B","text":"7.5"},{"id":"C","text":"8"},{"id":"D","text":"10"}],"answer":["B"],"explanation":"har number aadha hota ja raha hai: 15 ÷ 2 = 7.5."},{"id":"7","text":"A, D, I, P, ? — agla akshar kya hoga?","type":"single","marks":1,"negative":0,"options":[{"id":"A","text":"W"},{"id":"B","text":"X"},{"id":"C","text":"Y"},{"id":"D","text":"Z"}],"answer":["C"],"explanation":"antar +3, +5, +7, isliye agla +9: P(16) + 9 = 25 = Y."},{"id":"8","text":"Z, X, V, T, ? — agla akshar kya hoga?","type":"single","marks":1,"negative":0,"options":[{"id":"A","text":"P"},{"id":"B","text":"Q"},{"id":"C","text":"R"},{"id":"D","text":"S"}],"answer":["C"],"explanation":"har baar –2: T(20) – 2 = 18 = R."},{"id":"9","text":"3, 8, 15, 24, ? — agla number kya hoga?","type":"single","marks":1,"negative":0,"options":[{"id":"A","text":"32"},{"id":"B","text":"33"},{"id":"C","text":"35"},{"id":"D","text":"36"}],"answer":["C"],"explanation":"antar 5, 7, 9, isliye agla antar 11: 24 + 11 = 35."},{"id":"10","text":"2, 5, 10, 17, 26, ? — series poora karo.","type":"single","marks":1,"negative":0,"options":[{"id":"A","text":"35"},{"id":"B","text":"36"},{"id":"C","text":"37"},{"id":"D","text":"39"}],"answer":["C"],"explanation":"antar 3, 5, 7, 9, isliye agla antar 11: 26 + 11 = 37."},{"id":"11","text":"1, 1, 2, 3, 5, 8, ? — agla number kya hoga?","type":"single","marks":1,"negative":0,"options":[{"id":"A","text":"11"},{"id":"B","text":"12"},{"id":"C","text":"13"},{"id":"D","text":"15"}],"answer":["C"],"explanation":"Fibonacci series: 5 + 8 = 13."},{"id":"12","text":"Z, W, T, Q, ? — agla akshar kya hoga?","type":"single","marks":1,"negative":0,"options":[{"id":"A","text":"N"},{"id":"B","text":"O"},{"id":"C","text":"M"},{"id":"D","text":"P"}],"answer":["A"],"explanation":"har baar –3: Q(17) – 3 = 14 = N."}]}