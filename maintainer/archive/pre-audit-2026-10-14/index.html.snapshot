<dialog id="soonDlg"><div class="dlg">
  <h3 id="dlgTitle">Subject</h3><p id="dlgBody"></p>
  <p style="margin-top:10px"><b style="color:var(--navy)">Isme kya-kya aayega:</b></p><div class="chips" id="dlgChips" style="margin-top:7px"></div>
  <div class="startrow"><button class="btn btn-o" id="dlgNotify">🔔 Tayyar ho to batao</button><button class="btn btn-w" id="dlgClose">Band Karo</button></div>
  <p style="font-size:11.5px;color:var(--mut);margin-top:9px">Notify dabane par ye subject aapke browser me note ho jayega. Hum koi email/SMS nahi mangte.</p>
</div></dialog>
<div class="toast" id="toast"></div>

<script>
/* EkGuru Test Engine - Prakash (EkGuru Learning) | vanilla JS | data: assets/cn-questions.min.json | dubara banana: python3 tools/build_site_data.py */
"use strict";
var $=function(id){return document.getElementById(id)};
var TOPICS=[
 {id:"T01",n:"Introduction of DC",s:"DC ke 5 hisse, topology, LAN/MAN/WAN",q:375,book:"Topic%201%20-%20Introduction%20of%20DC%20-%20123%20MCQs%20(Answers%20%2B%20Nukte).pdf",prac:"Topic%201%20-%20Practice%20Questions%20-%20375Q%20(Test%20Booklet).pdf"},
 {id:"T02",n:"Network Models — OSI & TCP/IP",s:"7 layers, TCP/IP, encapsulation, PDU",q:144,book:"Topic%202%20-%20Network%20Models%20OSI%20TCP%20IP%20-%2082%20MCQs%20(Answers%20%2B%20Nukte).pdf",prac:"Topic%202%20-%20Practice%20Questions%20-%20144Q%20(Test%20Booklet).pdf"},
 {id:"T03",n:"Addressing — MAC, IPv4, IPv6, DNS",s:"IP classes, subnetting, CIDR, port, DNS",q:231,book:"Topic%203%20-%20Addressing%20MAC%20IPv4%20IPv6%20Port%20DNS%20-%2092%20MCQs%20(Answers%20%2B%20Nukte).pdf",prac:"Topic%203%20-%20Practice%20Questions%20-%20231Q%20(Test%20Booklet).pdf"},
 {id:"T04",n:"Networking Devices",s:"Hub, Switch, Router, Gateway, Firewall",q:99,book:"Topic%204%20-%20Networking%20Devices%20-%2038%20MCQs%20(Answers%20%2B%20Nukte).pdf",prac:"Topic%204%20-%20Practice%20Questions%20-%2099Q%20(Test%20Booklet).pdf"},
 {id:"T05",n:"Transmission Medium",s:"Twisted pair, Fiber, Radio, Shannon",q:174,book:"Topic%205%20-%20Transmission%20Medium%20-%2047%20MCQs%20(Answers%20%2B%20Nukte).pdf",prac:"Topic%205%20-%20Practice%20Questions%20-%20174Q%20(Test%20Booklet).pdf"},
 {id:"T06",n:"OSI Layers in Detail",s:"har layer gehrai se — TCP/UDP, Routing, HTTP",q:387,book:"Topic%206%20-%20OSI%20Layers%20in%20Detail%20-%20192%20MCQs%20(Answers%20%2B%20Nukte).pdf",prac:"Topic%206%20-%20Practice%20Questions%20-%20387Q%20(Test%20Booklet).pdf"},
 {id:"T07",n:"Network Security",s:"Cryptography, Firewall, VPN, TLS, WPA2",q:146,book:"Topic%207%20-%20Network%20Security%20-%2053%20MCQs%20(Answers%20%2B%20Nukte).pdf",prac:"Topic%207%20-%20Practice%20Questions%20-%20146Q%20(Test%20Booklet).pdf"}];
var SUBJECTS=[
 {nm:"Computer Network",hi:"कंप्यूटर नेटवर्क (Data Communication)",st:"live",pct:100,txt:"Poora bank live hai — 7 topics, 1,556 bilingual MCQ, asli Rajasthan papers + Forouzan se verified.",chips:["1,556 Questions","7 Topics","EN + हिंदी","Answer + Nukta"]},
 {nm:"DBMS",hi:"Database Management System",st:"soon",pct:35,txt:"Material jama ho raha hai. ER model se lekar Normalization aur SQL tak — pehle verify, phir live.",chips:["ER Model","Normalization","SQL","Transactions","Indexing"]},
 {nm:"Java Programming",hi:"जावा प्रोग्रामिंग",st:"soon",pct:25,txt:"Core Java ke sawaal ban rahe hain — OOP, Collection, Exception sab kuch exam pattern par.",chips:["OOP","Collection","Exception","Multithreading","JDBC"]},
 {nm:"SAD",hi:"System Analysis & Design",st:"soon",pct:20,txt:"SDLC, DFD aur UML wale sawaal tayyar ho rahe hain. IA/SA exams me ye bada hissa hai.",chips:["SDLC","DFD","UML","Feasibility","Testing"]},
 {nm:"Operating System",hi:"ऑपरेटिंग सिस्टम",st:"soon",pct:15,txt:"Process, Memory aur Scheduling — CN ke baad iski baari hai. Syllabus map ban gaya hai.",chips:["Process","Scheduling","Memory","Deadlock","File System"]},
 {nm:"Data Structures",hi:"डेटा स्ट्रक्चर",st:"soon",pct:10,txt:"Stack-Queue se Graph tak. Pehle CN jaisa pakka bank banega, phir test khulega.",chips:["Stack & Queue","Tree","Graph","Sorting","Hashing"]},
 {nm:"C Programming",hi:"C भाषा",st:"soon",pct:10,txt:"Pointers aur output-wale sawaal — programmer exam ki jaan. List tayyar hai.",chips:["Pointers","Array","Functions","Output Questions"]},
 {nm:"Computer Fundamentals",hi:"कंप्यूटर परिचय",st:"soon",pct:30,txt:"Har exam ka pehla darwaza. Hardware, Software, Number System — basic se shuru.",chips:["Hardware","Number System","MS Office","Shortcut Keys"]},
 {nm:"Geography — Rajasthan Map",hi:"राजस्थान का भूगोल (Map)",st:"make",pct:45,txt:"Map-based padhai ban rahi hai — jile, nadiyaan, khanij. Tasveer dekh kar seekhne wala hissa.",chips:["Rajasthan Map","Nadiyaan","Khanij","Jile"]}];
function goEl(e){if(e&&e.scrollIntoView)e.scrollIntoView({behavior:"smooth"})}
function toast(m){var t=$("toast");t.textContent=m;t.classList.add("show");clearTimeout(t._h);t._h=setTimeout(function(){t.classList.remove("show")},3400)}
function esc(s){return String(s==null?"":s).replace(/[&<>"]/g,function(c){return{"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c]})}
function shuffle(a){for(var i=a.length-1;i>0;i--){var j=Math.floor(Math.random()*(i+1)),t=a[i];a[i]=a[j];a[j]=t}return a}
function store(k,v){try{localStorage.setItem("ekguru_"+k,JSON.stringify(v))}catch(e){}}
function read(k,d){try{var v=localStorage.getItem("ekguru_"+k);return v?JSON.parse(v):d}catch(e){return d}}
(function(){var g=$("subGrid"),h="";
 SUBJECTS.forEach(function(s,i){
  var tag=s.st==="live"?'<span class="tag live">● Live</span>':s.st==="make"?'<span class="tag make">✎ Ban Raha Hai</span>':'<span class="tag soon">⏳ Coming Soon</span>';
  var btns=s.st==="live"?'<a class="mini o" href="#test">▶ Test Do</a><a class="mini w" href="#books">PDF Books</a>'
    :'<button class="mini o" data-soon="'+i+'">Kya Aayega?</button><button class="mini w" data-notify="'+i+'">🔔 Notify Me</button>';
  h+='<div class="subj">'+tag+'<div class="nm">'+esc(s.nm)+'</div><div class="hi">'+esc(s.hi)+'</div><p>'+esc(s.txt)+'</p><div class="chips">'
    +s.chips.map(function(c){return '<span class="chip">'+esc(c)+"</span>"}).join("")+'</div><div class="bar"><i style="width:'+s.pct+'%"></i></div><span class="pct">Tayyari: '+s.pct+'%</span><div class="row">'+btns+"</div></div>"});
 g.innerHTML=h;
 g.addEventListener("click",function(e){var a=e.target.closest("[data-soon]"),b=e.target.closest("[data-notify]");
   if(a)openSoon(+a.getAttribute("data-soon"));if(b)notify(+b.getAttribute("data-notify"))})})();
function openSoon(i){var s=SUBJECTS[i];$("dlgTitle").textContent=s.nm+" — Coming Soon";
 $("dlgBody").textContent=s.txt;$("dlgChips").innerHTML=s.chips.map(function(c){return '<span class="chip">'+esc(c)+"</span>"}).join("");
 $("dlgNotify").onclick=function(){notify(i);$("soonDlg").close()};$("soonDlg").showModal()}
function notify(i){var list=read("notify",[]);if(list.indexOf(SUBJECTS[i].nm)<0)list.push(SUBJECTS[i].nm);store("notify",list);
 toast("🔔 Note ho gaya! "+SUBJECTS[i].nm+" tayyar hote hi is page par LIVE dikhega.")}
$("dlgClose").onclick=function(){$("soonDlg").close()};
function drawRegister(){var h=read("history",[]);$("rMine").textContent=h.length;
 if(h.length){$("rBest").textContent=Math.max.apply(null,h.map(function(x){return x.pct}))+"%"}}
(function(){var h="";TOPICS.forEach(function(t,i){
 h+="<tr><td><b>"+(i+1)+"</b></td><td><b style='color:var(--navy)'>"+esc(t.n)+"</b></td><td>"+esc(t.s)+"</td>"
  +'<td><button class="mini o" data-tstart="'+t.id+'">▶ Test ('+t.q+' Q)</button><br><a target="_blank" href="Computer%20Network/Online%20Quiz/Topic%20'+(i+1)+'%20-%20Online%20Quiz%20%26%20Exam%20(by%20PRAKASH%20-%20EkGuru).html">Full CBT Page ↗</a></td>'
  +'<td><a target="_blank" href="Computer%20Network/'+t.book+'">⬇ PDF</a></td>'
  +'<td><a target="_blank" href="Computer%20Network/Practice/'+t.prac+'">⬇ PDF ('+t.q+' Q)</a></td></tr>'});$("bkBody").innerHTML=h;
 $("bkBody").addEventListener("click",function(e){var b=e.target.closest("[data-tstart]");if(!b)return;
   setSeg("fTopic",b.getAttribute("data-tstart"));goEl(document.getElementById("test"));startTest()})})();
var BANK=null,SET={topic:"ALL",mode:"practice",count:20,diff:"all",lang:"both",neg:0};
var PLAY={on:false,list:[],cur:0,ans:{},seen:{},mark:{},mode:"practice",lang:"both",neg:0,secs:0,timer:null,started:0};
function segInit(id,key,fn){var box=$(id);box.addEventListener("click",function(e){var b=e.target.closest("button");if(!b||b.disabled)return;
 box.querySelectorAll("button").forEach(function(x){x.classList.remove("on")});b.classList.add("on");
 SET[key]=isNaN(+b.dataset.v)?b.dataset.v:+b.dataset.v;if(fn)fn()})}
function setSeg(id,val){$(id).querySelectorAll("button").forEach(function(b){b.classList.toggle("on",b.dataset.v==String(val))});
 var k={fTopic:"topic",fMode:"mode",fCount:"count",fDiff:"diff",fLang:"lang",fNeg:"neg"}[id];if(k)SET[k]=isNaN(+val)?val:+val;refreshPool()}
(function(){var h='<button data-v="ALL" class="on">Sab Topics</button>';TOPICS.forEach(function(t){h+='<button data-v="'+t.id+'">T'+t.id.slice(1)+" · "+esc(t.n.split("—")[0].trim())+"</button>"});$("fTopic").innerHTML=h})();
segInit("fTopic","topic",refreshPool);segInit("fCount","count",refreshPool);segInit("fDiff","diff",refreshPool);
segInit("fLang","lang",function(){if(PLAY.on)drawQ()});segInit("fNeg","neg");
segInit("fMode","mode",function(){var ex=SET.mode==="exam";$("negWrap").style.display=ex?"":"none";
 $("modeNote").textContent=ex?"Exam: timer chalega, jawab submit ke baad hi dikhega. Asli paper jaisa.":"Practice: jawab dete hi sahi/galti + Nukta dikhega.";if(PLAY.on)drawQ()});
function pool(){if(!BANK)return[];return BANK.filter(function(q){return(SET.topic==="ALL"||q.t===SET.topic)&&(SET.diff==="all"||q.d===SET.diff)})}
function refreshPool(){if(!BANK)return;var p=pool();
 $("poolInfo").innerHTML="Is selection me <b>"+p.length+"</b> question mile. Test me <b>"+Math.min(SET.count,p.length)+"</b> aayenge, har baar alag (shuffle).";
 $("btnStart").disabled=!p.length;$("btnStart").textContent=p.length?"▶ Test Shuru Karo ("+Math.min(SET.count,p.length)+" Question)":"Is selection me question nahi hai"}
function loadBank(){ /* naye browser me fetch, purane me XHR — dono chalega */
 function ok(d){BANK=d;$("rTotal").textContent=d.length.toLocaleString("en-IN");refreshPool();drawRegister()}
 function fail(){$("poolInfo").innerHTML="<b style='color:var(--red)'>Bank load nahi hua.</b> Page refresh karo.";toast("⚠ Question bank load nahi hua — page refresh karke dekho.")}
 if(window.fetch){fetch("assets/cn-questions.min.json").then(function(r){if(!r.ok)throw 0;return r.json()}).then(ok).catch(fail)}
 else{var x=new XMLHttpRequest();x.open("GET","assets/cn-questions.min.json",true);
  x.onload=function(){try{ok(JSON.parse(x.responseText))}catch(e){fail()}};x.onerror=fail;x.send()}}
loadBank();
function begin(list,mode){
 if(!list.length){toast("Is selection me question nahi mile — Topic/Difficulty badal kar dekho.");return}
 PLAY={on:true,list:shuffle(list.slice()),cur:0,ans:{},seen:{},mark:{},mode:mode,lang:SET.lang,neg:mode==="exam"?+SET.neg:0,secs:mode==="exam"?list.length*60:0,timer:null,started:Date.now()};
 $("setupPanel").style.display="none";$("result").style.display="none";$("player").style.display="block";
 if(mode==="exam")PLAY.timer=setInterval(tick,1000);
 $("timerBox").style.visibility=mode==="exam"?"visible":"hidden";
 drawPal();drawQ();goEl(document.getElementById("test"))}
function tick(){PLAY.secs--;if(PLAY.secs<=0){clearInterval(PLAY.timer);toast("⏰ Samay khatm! Test khud submit ho gaya.");finish(true);return}drawTime()}
function drawTime(){var s=Math.max(0,PLAY.secs),m=Math.floor(s/60),r=s%60;$("tTime").textContent=(m<10?"0":"")+m+":"+(r<10?"0":"")+r;$("tTime").className="v"+(s<60?" low":"")}
function startTest(){begin(shuffle(pool().slice()).slice(0,SET.count),SET.mode)}
$("btnStart").onclick=startTest;
$("btnRandom").onclick=function(){if(!BANK){toast("Bank abhi load ho raha hai…");return}setSeg("fTopic","ALL");begin(shuffle(BANK.slice()).slice(0,20),Math.random()<.5?"practice":"exam")};
function langTxt(en,hi){if(PLAY.lang==="en")return esc(en);if(PLAY.lang==="hi")return esc(hi||en);
 return esc(en)+(hi&&hi!==en?'<span class="hi">'+esc(hi)+"</span>":"")}
function drawQ(){var q=PLAY.list[PLAY.cur];if(!q)return;PLAY.seen[PLAY.cur]=1;
 $("qNo").textContent="Q."+(PLAY.cur+1);$("tQno").textContent=(PLAY.cur+1)+" / "+PLAY.list.length;
 var t=TOPICS.filter(function(x){return x.id===q.t})[0];
 $("qTopic").textContent=q.t+" · "+(t?t.n:"CN");$("qDiff").textContent=q.d;$("qDiff").className="bdg "+q.d;
 $("qId").textContent=q.i;$("qSrc").textContent=q.src||"";
 $("qText").innerHTML=langTxt(q.q,q.qh);
 var picked=PLAY.ans[PLAY.cur],show=PLAY.mode==="practice"&&picked!==undefined,h="";
 q.o.forEach(function(op,i){var cls="opt";if(picked===i)cls+=" sel";
   if(show&&i===q.a)cls+=" right";if(show&&picked===i&&i!==q.a)cls+=" wrong";
   var hi=q.oh&&q.oh[i]?q.oh[i]:"";
   h+='<button class="opt" data-opt="'+i+'"><span class="ab">'+"ABCD"[i]+'</span><span>'+(PLAY.lang==="hi"?esc(hi||op):PLAY.lang==="en"?esc(op):esc(op)+(hi&&hi!==op?'<span class="hi">'+esc(hi)+"</span>":""))+"</span></button>"});
 $("optBox").innerHTML=h;
 var ex=$("explBox");
 if(show){ex.innerHTML=(picked===q.a?'<b class="t">✔ Sahi jawab!</b>':'<b style="color:var(--red)">✘ Galat.</b> Sahi jawab: <b>'+"ABCD"[q.a]+"</b>")
   +"<br>"+langTxt(q.e,q.eh)+(q.n?'<div class="nuk">★ <b>Nukta (exam point):</b> '+langTxt(q.n,q.nh)+"</div>":"");ex.classList.add("show")}
 else{ex.classList.remove("show");ex.innerHTML=""}
 $("btnMark").classList.toggle("markon",!!PLAY.mark[PLAY.cur]);
 $("btnMark").textContent=PLAY.mark[PLAY.cur]?"⚑ Marked (hatane ke liye dabao)":"⚑ Mark for Review";
 $("btnPrev").disabled=PLAY.cur===0;$("btnNext").textContent=PLAY.cur===PLAY.list.length-1?"Aakhri Question":"Agla →";
 var done=Object.keys(PLAY.ans).length;$("tAns").textContent=done;$("tScore").textContent=liveScore();
 $("pFill").style.width=Math.round(done/PLAY.list.length*100)+"%";
 if(PLAY.mode==="exam")drawTime();drawPal()}
function liveScore(){var s=0;PLAY.list.forEach(function(q,i){if(PLAY.ans[i]===q.a)s++;else if(PLAY.ans[i]!==undefined)s-=PLAY.neg});return Math.round(s*100)/100}
$("optBox").addEventListener("click",function(e){var b=e.target.closest("[data-opt]");if(!b)return;PLAY.ans[PLAY.cur]=+b.getAttribute("data-opt");drawQ()});
$("btnClear").onclick=function(){delete PLAY.ans[PLAY.cur];drawQ()};
$("btnMark").onclick=function(){PLAY.mark[PLAY.cur]=!PLAY.mark[PLAY.cur];drawQ()};
$("btnPrev").onclick=function(){if(PLAY.cur>0){PLAY.cur--;drawQ()}};
$("btnNext").onclick=function(){if(PLAY.cur<PLAY.list.length-1){PLAY.cur++;drawQ()}else toast("Ye aakhri question hai. Submit karna ho to ✔ Submit Test dabao.")};
$("btnPalette").onclick=function(){var p=$("palBox");p.style.display=p.style.display==="none"?"":"none"};
function drawPal(){var h="";PLAY.list.forEach(function(q,i){var c="pn";var a=PLAY.ans[i]!==undefined,m=PLAY.mark[i];
 if(a&&m)c+=" dm";else if(a)c+=" done";else if(m)c+=" mark";else if(PLAY.seen[i])c+=" seen";if(i===PLAY.cur)c+=" cur";
 h+='<button class="'+c+'" data-go="'+i+'">'+(i+1)+"</button>"});$("pGrid").innerHTML=h}
$("pGrid").addEventListener("click",function(e){var b=e.target.closest("[data-go]");if(b){PLAY.cur=+b.getAttribute("data-go");drawQ()}});
function finish(auto){if(!PLAY.on)return;
 var left=PLAY.list.length-Object.keys(PLAY.ans).length;
 if(!auto&&left>0&&!confirm(left+" question bina jawab ke hain. Phir bhi submit karna hai?"))return;
 clearInterval(PLAY.timer);PLAY.on=false;
 var right=0,wrong=0,per={};
 PLAY.list.forEach(function(q,i){per[q.t]=per[q.t]||{r:0,w:0,s:0};
   if(PLAY.ans[i]===undefined)per[q.t].s++;else if(PLAY.ans[i]===q.a){right++;per[q.t].r++}else{wrong++;per[q.t].w++}});
 var score=Math.round((right-wrong*PLAY.neg)*100)/100,total=PLAY.list.length,pct=Math.max(0,Math.round(score/total*100));
 var mins=Math.round((Date.now()-PLAY.started)/60000*10)/10;
 $("scoreBand").innerHTML=[["Score",score+" / "+total],["Sahi ✔",right],["Galat ✘",wrong],["Chhode",total-right-wrong],["Percentage",pct+"%"],["Samay",mins+" min"]]
   .map(function(x){return '<div class="sc"><div class="v">'+x[1]+'</div><div class="l">'+x[0]+"</div></div>"}).join("");
 var ah="<thead><tr><th>Topic</th><th>Sahi</th><th>Galat</th><th>Chhode</th><th>Haal</th></tr></thead><tbody>";
 Object.keys(per).sort().forEach(function(t){var p=per[t],tt=TOPICS.filter(function(x){return x.id===t})[0];
   ah+="<tr><td><b>"+t+"</b> "+(tt?esc(tt.n):"")+"</td><td>"+p.r+"</td><td>"+p.w+"</td><td>"+p.s+"</td><td>"+(p.w===0&&p.s===0?"🌟 Pakka hai":p.r>=p.w?"👍 Thik-thaak, thoda aur":"📌 Yahi topic dobara padho")+"</td></tr>"});
 $("anTable").innerHTML=ah+"</tbody>";$("wrongN").textContent=wrong;
 var hist=read("history",[]);hist.push({d:new Date().toLocaleDateString("en-IN"),pct:pct,score:score,total:total,mode:PLAY.mode});if(hist.length>30)hist=hist.slice(-30);store("history",hist);drawRegister();
 window._wrongList=PLAY.list.filter(function(q,i){return PLAY.ans[i]!==undefined&&PLAY.ans[i]!==q.a});
 window._lastList=PLAY.list;window._lastAns=PLAY.ans;
 $("player").style.display="none";$("result").style.display="block";$("setupPanel").style.display="";
 goEl(document.getElementById("result"));
 toast(pct>=70?"🎉 Badhai ho! "+pct+"% — aise hi lage raho.":pct>=40?"👍 "+pct+"% — galat wale dobara do, pakka ho jayega.":"📌 "+pct+"% — pehle Practice mode me Nukte padho, phir exam do.")}
$("btnFinish").onclick=function(){finish(false)};$("btnFinishTop").onclick=function(){finish(false)};
$("btnAgain").onclick=function(){$("result").style.display="none";goEl(document.getElementById("test"))};
$("btnWrong").onclick=function(){if(!window._wrongList||!window._wrongList.length){toast("koi galat question nahi hai — kamaal! 🎉");return}begin(window._wrongList,"practice")};
$("btnReview").onclick=function(){var box=$("revBox");if(box.innerHTML){box.innerHTML="";return}
 var h='<div class="shead" style="margin-top:6px"><h2 style="font-size:19px">Saare Jawab — Review</h2></div>';
 window._lastList.forEach(function(q,i){var a=window._lastAns[i],ok=a===q.a;
  h+='<div class="rev"><b>Q.'+(i+1)+'</b> <span style="color:var(--mut)">'+q.i+" · "+q.t+'</span> '+(a===undefined?'<span class="bad">— jawab nahi diya</span>':ok?'<span class="ok">✔ Sahi</span>':'<span class="bad">✘ Galat</span>')
   +'<div style="margin-top:5px;font-weight:600">'+esc(q.q)+'</div><div>Aapka jawab: <b>'+(a===undefined?"—":"ABCD"[a]+") "+esc(q.o[a]))+'</b> &nbsp;|&nbsp; Sahi: <b style="color:var(--grn)">'+"ABCD"[q.a]+") "+esc(q.o[q.a])+"</b></div>"
   +(q.e?'<div style="color:#43536a;margin-top:4px">'+esc(q.e)+"</div>":"")+(q.n?'<div style="margin-top:4px">★ <b>Nukta:</b> '+esc(q.n)+"</div>":"")+"</div>"});
 box.innerHTML=h;goEl(box)};
document.querySelectorAll("[data-topic]").forEach(function(a){a.addEventListener("click",function(){setSeg("fTopic",a.getAttribute("data-topic"))})});
drawRegister();
window.addEventListener("beforeunload",function(e){if(PLAY.on){e.preventDefault();e.returnValue=""}});
</script>
</body>
</html>
