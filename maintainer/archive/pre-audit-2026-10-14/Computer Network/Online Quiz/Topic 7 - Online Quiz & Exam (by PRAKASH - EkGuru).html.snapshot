<script>
const QUESTIONS = [{"q": ["The term 'CIA triad' in information security refers to:", "Information security में 'CIA triad' शब्द किसे कहते हैं?"], "opts": [["Cryptography, Integrity, Authentication", ""], ["Confidentiality, Integrity, Availability", ""], ["Confidentiality, Information, Access", ""], ["Control, Information, Access", ""]], "ans": 1, "exp": ["The CIA triad = Confidentiality (only authorised access), Integrity (no unauthorised change), Availability (accessible when needed) — the three core security goals. | Nukta: CIA = Confidentiality, Integrity, Availability. AAA (authentication, authorisation, accounting) is a separate trio.", "CIA triad = Confidentiality (केवल authorised access), Integrity (बिना authorisation बदलाव नहीं), Availability (ज़रूरत पर उपलब्ध) — तीन मूल security goals। | CIA = Confidentiality, Integrity, Availability। AAA (authentication, authorisation, accounting) अलग trio है।"], "src": "Repo: BCI_SCI Subject Test-01 (CN and Security)", "sec": "Section A — Security Goals & Attacks", "diff": "medium", "stype": "repository_internal", "style": "concept", "tags": ["RSMSSB Informatics Assistant", "SSC Computer Awareness", "RPSC Programmer"]}, {"q": ["The goal of 'Integrity' ensures that:", "'Integrity' का लक्ष्य सुनिश्चित करता है कि:"], "opts": [["Data can be accessed only by authorised users", ""], ["Data is accurate and has not been modified", ""], ["Data is always available when needed", ""], ["Unauthorised users cannot enter the system", ""]], "ans": 1, "exp": ["Integrity means data remains accurate and unaltered except by authorised people — checksums/digital signatures protect it. | Nukta: Goal map: Confidentiality = authorised access only. Integrity = no unauthorised change. Availability = always accessible.", "Integrity का अर्थ है data सही और अपरिवर्तित रहे (केवल authorised लोग ही बदलें) — इसे checksums/digital signatures सुरक्षित रखते हैं। | Goal map: Confidentiality = केवल authorised access। Integrity = बिना authorisation बदलाव नहीं। Availability = हमेशा उपलब्ध।"], "src": "Repo: BCI_SCI Subject Test-01 (CN and Security)", "sec": "Section A — Security Goals & Attacks", "diff": "hard", "stype": "repository_internal", "style": "concept", "tags": ["GATE CS", "UGC-NET 087", "RPSC Programmer", "RPSC ACP/DD"]}, {"q": ["Which of the following is NOT a goal of network security?", "निम्न में से कौन-सा network security का लक्ष्य नहीं है?"], "opts": [["Confidentiality", ""], ["Integrity", ""], ["Availability", ""], ["Redundancy", ""]], "ans": 3, "exp": ["Redundancy (duplicate links/equipment) improves fault tolerance — it is a reliability technique, not a security goal. | Nukta: Security goals = CIA. Reliability goals = redundancy, fault tolerance, recovery.", "Redundancy (duplicate links/equipment) fault tolerance बढ़ाती है — यह reliability तकनीक है, security लक्ष्य नहीं। | Security goals = CIA। Reliability goals = redundancy, fault tolerance, recovery।"], "src": "Subject Test Solution-1 Part-2 (CN & Security) slides", "sec": "Section A — Security Goals & Attacks", "diff": "hard", "stype": "repository_internal", "style": "concept", "tags": ["GATE CS", "UGC-NET 087", "RPSC Programmer", "RPSC ACP/DD"]}, {"q": ["A modification attack violates which security goal?", "Modification attack कौन-से security लक्ष्य का उल्लंघन करता है?"], "opts": [["Confidentiality", ""], ["Integrity", ""], ["Availability", ""], ["Authentication", ""]], "ans": 1, "exp": ["A modification attack changes data in transit — that breaks INTEGRITY (data is no longer accurate/unaltered). | Nukta: Attack→goal: Eavesdropping/Interception → Confidentiality. Modification → Integrity. DoS/Interruption → Availability. Spoofing → Authentication.", "Modification attack रास्ते में data बदल देता है — यह INTEGRITY तोड़ता है (data अब सही/अपरिवर्तित नहीं)। | Attack→goal: Eavesdropping/Interception → Confidentiality। Modification → Integrity। DoS/Interruption → Availability। Spoofing → Authentication।"], "src": "Repo: BCI_SCI Subject Test-01 (CN and Security)", "sec": "Section A — Security Goals & Attacks", "diff": "medium", "stype": "repository_internal", "style": "concept", "tags": ["RSMSSB Informatics Assistant", "SSC Computer Awareness", "RPSC Programmer"]}, {"q": ["Which of the following attacks violates confidentiality?", "निम्न में से कौन-सा attack confidentiality का उल्लंघन करता है?"], "opts": [["Interception", ""], ["Modification", ""], ["Fabrication", ""], ["Interruption", ""]], "ans": 0, "exp": ["Interception (eavesdropping) lets an unauthorised party READ the data — breaking confidentiality. | Nukta: Attack map: Interception→Confidentiality, Modification→Integrity, Fabrication→Authenticity, Interruption→Availability.", "Interception (eavesdropping) से unauthorised पक्ष data पढ़ लेता है — confidentiality टूटती है। | Attack map: Interception→Confidentiality, Modification→Integrity, Fabrication→Authenticity, Interruption→Availability।"], "src": "Subject Test Solution-1 Part-2 (CN & Security) slides", "sec": "Section A — Security Goals & Attacks", "diff": "medium", "stype": "repository_internal", "style": "concept", "tags": ["RSMSSB Informatics Assistant", "SSC Computer Awareness", "RPSC Programmer"]}, {"q": ["A Denial of Service (DoS) attack violates which goal?", "Denial of Service (DoS) attack कौन-से लक्ष्य का उल्लंघन करता है?"], "opts": [["Confidentiality", ""], ["Integrity", ""], ["Availability", ""], ["Authentication", ""]], "ans": 2, "exp": ["A DoS attack floods a server/network so legitimate users cannot access the service — breaking AVAILABILITY. | Nukta: DoS = Availability attack. DDoS = distributed DoS. Smurf/ SYN-flood = DoS variants.", "DoS attack server/network को flood करके legitimate users को service से रोकता है — Availability टूटती है। | DoS = Availability attack। DDoS = distributed DoS। Smurf/ SYN-flood = DoS variants।"], "src": "Repo: BCI_SCI Subject Test-01 (CN and Security)", "sec": "Section A — Security Goals & Attacks", "diff": "medium", "stype": "repository_internal", "style": "concept", "tags": ["RSMSSB Informatics Assistant", "SSC Computer Awareness", "RPSC Programmer"]}, {"q": ["A spoofing attack targets which security aspect?", "Spoofing attack किस security पहलू को लक्षित करता है?"], "opts": [["Authentication", ""], ["Integrity", ""], ["Availability", ""], ["Confidentiality", ""]], "ans": 0, "exp": ["Spoofing pretends to be someone else (fake IP/MAC/email id) — it attacks AUTHENTICATION (who you claim to be). | Nukta: Spoofing/impersonation → Authentication. Phishing → steals credentials (auth). Sniffing → Confidentiality.", "Spoofing किसी और का रूप धारण करता है (fake IP/MAC/email id) — यह AUTHENTICATION पर हमला है (आप कौन हैं)। | Spoofing/impersonation → Authentication। Phishing → credentials चुराता है (auth)। Sniffing → Confidentiality।"], "src": "Repo: BCI_SCI Subject Test-01 (CN and Security)", "sec": "Section A — Security Goals & Attacks", "diff": "medium", "stype": "repository_internal", "style": "concept", "tags": ["RSMSSB Informatics Assistant", "SSC Computer Awareness", "RPSC Programmer"]}, {"q": ["Which of the following is an ACTIVE attack?", "निम्न में से कौन-सा ACTIVE attack है?"], "opts": [["Interception", ""], ["Modification", ""], ["Traffic analysis", ""], ["Eavesdropping", ""]], "ans": 1, "exp": ["Modification is an active attack — the attacker CHANGES the data stream; interception/traffic analysis/eavesdropping are passive (they only observe). | Nukta: Passive = observe only (eavesdropping, traffic analysis). Active = change/disrupt (modification, fabrication, interruption/DoS).", "Modification एक active attack है — attacker data stream बदलता है; interception/traffic analysis/eavesdropping passive हैं (केवल देखते हैं)। | Passive = केवल देखना (eavesdropping, traffic analysis)। Active = बदलना/बाधा (modification, fabrication, interruption/DoS)।"], "src": "Repo: BCI_SCI Subject Test-01 (CN and Security)", "sec": "Section A — Security Goals & Attacks", "diff": "medium", "stype": "repository_internal", "style": "concept", "tags": ["RSMSSB Informatics Assistant", "SSC Computer Awareness", "RPSC Programmer"]}, {"q": ["The primary difference between active and passive attacks is:", "Active और passive attacks के बीच मुख्य अंतर क्या है?"], "opts": [["Active attacks change data; passive attacks do not", ""], ["Passive attacks destroy hardware", ""], ["Both are the same", ""], ["Passive attacks are legal", ""]], "ans": 0, "exp": ["Active attacks intercept AND modify/disrupt the communication; passive attacks only eavesdrop without changing anything. | Nukta: Active: modification, fabrication, interruption. Passive: eavesdropping, traffic analysis. Exam one-liner: 'change vs observe'.", "Active attacks संचार को intercept करके बदलते/बाधित करते हैं; passive attacks केवल सुनते हैं, कुछ नहीं बदलते। | Active: modification, fabrication, interruption। Passive: eavesdropping, traffic analysis। Exam one-liner: 'change बनाम observe'।"], "src": "Repo: BCI_SCI Subject Test-01 (CN and Security)", "sec": "Section A — Security Goals & Attacks", "diff": "hard", "stype": "repository_internal", "style": "concept", "tags": ["GATE CS", "UGC-NET 087", "RPSC Programmer", "RPSC ACP/DD"]}, {"q": ["In the virus life cycle, which phase actually performs the malicious activity?", "Virus life cycle में कौन-सा phase वास्तव में malicious activity करता है?"], "opts": [["Infection Phase", ""], ["Triggering Phase", ""], ["Dormant Phase", ""], ["Execution (Payload) Phase", ""]], "ans": 3, "exp": ["The execution phase runs the payload — the actual damage (deleting files, corrupting data). | Nukta: Virus phases: Dormant (idle) → Propagation (copy) → Triggering (condition met) → Execution (payload runs).", "Execution phase payload चलाता है — वास्तविक नुकसान (files delete करना, data खराब करना)। | Virus phases: Dormant (idle) → Propagation (copy) → Triggering (condition met) → Execution (payload runs)।"], "src": "Repo: BCI Subject Test-9 (BCI/SCI Batch)", "sec": "Section A — Security Goals & Attacks", "diff": "easy", "stype": "repository_internal", "style": "concept", "tags": ["SSC Computer Awareness", "RSMSSB Informatics Assistant", "JNV TAT"]}, {"q": ["Which backup medium provides Write-Once-Read-Many (WORM) functionality?", "कौन-सा backup medium Write-Once-Read-Many (WORM) functionality देता है?"], "opts": [["Hard disk", ""], ["Magnetic tape", ""], ["Optical disk (CD-R / DVD-R)", ""], ["Flash drive", ""]], "ans": 2, "exp": ["CD-R/DVD-R optical disks are WORM — data is written once and cannot be altered, making them tamper-proof archives. | Nukta: WORM = optical write-once media (CD-R/DVD-R/BD-R). Rewritable: HDD, tape (LTO), flash, CD-RW.", "CD-R/DVD-R optical disks WORM हैं — data एक बार लिखा जाता है और बदला नहीं जा सकता, इसलिए ये tamper-proof archives हैं। | WORM = optical write-once media (CD-R/DVD-R/BD-R)। Rewritable: HDD, tape (LTO), flash, CD-RW।"], "src": "Repo: BCI Subject Test-9 (BCI/SCI Batch)", "sec": "Section A — Security Goals & Attacks", "diff": "easy", "stype": "repository_internal", "style": "concept", "tags": ["SSC Computer Awareness", "RSMSSB Informatics Assistant", "JNV TAT"]}, {"q": ["Which attack becomes possible if the SAME key is reused many times in symmetric encryption?", "यदि symmetric encryption में एक ही key कई बार उपयोग हो, तो कौन-सा attack संभव हो जाता है?"], "opts": [["Replay attack", ""], ["Known-plaintext attack", ""], ["Man-in-the-middle attack", ""], ["Phishing attack", ""]], "ans": 1, "exp": ["With many ciphertexts under one key, an attacker can compare them with known plaintexts and deduce the key — a known-plaintext (or frequency-analysis) attack. | Nukta: One-time pads are safe ONLY with a fresh key per message. Reuse → pattern analysis. Exam favourite link: key reuse → known-plaintext.", "एक key के अंतर्गत अनेक ciphertexts होने पर attacker उन्हें known plaintexts से मिलाकर key निकाल सकता है — known-plaintext (या frequency-analysis) attack। | One-time pads केवल हर message पर नई key से सुरक्षित हैं। Reuse → pattern analysis। Exam favourite link: key reuse → known-plaintext।"], "src": "Repo: BCI Subject Test-9 (BCI/SCI Batch)", "sec": "Section A — Security Goals & Attacks", "diff": "easy", "stype": "repository_internal", "style": "concept", "tags": ["SSC Computer Awareness", "RSMSSB Informatics Assistant", "JNV TAT"]}, {"q": ["Which of the following tools is mainly used for password cracking?", "निम्न में से कौन-सा tool मुख्यतः password cracking के लिए उपयोग होता है?"], "opts": [["Wireshark", ""], ["Nmap", ""], ["Cain and Abel", ""], ["Angry IP Scanner", ""]], "ans": 2, "exp": ["Cain and Abel is a well-known password-recovery/cracking tool (sniffing, dictionary & brute-force attacks). | Nukta: Security tools: Wireshark = packet analyser, Nmap = port scanner, Cain&Abel = password cracker, Angry IP Scanner = IP scanner, Snort = IDS.", "Cain and Abel एक प्रसिद्ध password-recovery/cracking tool है (sniffing, dictionary और brute-force attacks)। | Security tools: Wireshark = packet analyser, Nmap = port scanner, Cain&Abel = password cracker, Angry IP Scanner = IP scanner, Snort = IDS।"], "src": "Repo: BCI Subject Test-9 (BCI/SCI Batch)", "sec": "Section A — Security Goals & Attacks", "diff": "easy", "stype": "repository_internal", "style": "concept", "tags": ["SSC Computer Awareness", "RSMSSB Informatics Assistant", "JNV TAT"]}, {"q": ["Which port and IP address scanner is most famous among users?", "Users के बीच सबसे प्रसिद्ध port और IP address scanner कौन-सा है?"], "opts": [["Cain and Abel", ""], ["Angry IP Scanner", ""], ["Snort", ""], ["Ettercap", ""]], "ans": 1, "exp": ["Angry IP Scanner is the popular free tool for scanning IP ranges and open ports. | Nukta: Cain&Abel = password cracking; Angry IP = IP/port scan; Snort = IDS; Ettercap = sniffing/ARP spoofing.", "Angry IP Scanner IP ranges और open ports scan करने वाला लोकप्रिय free tool है। | Cain&Abel = password cracking; Angry IP = IP/port scan; Snort = IDS; Ettercap = sniffing/ARP spoofing।"], "src": "Repo: BCI Subject Test-9 (BCI/SCI Batch)", "sec": "Section A — Security Goals & Attacks", "diff": "easy", "stype": "repository_internal", "style": "concept", "tags": ["SSC Computer Awareness", "RSMSSB Informatics Assistant", "JNV TAT"]}, {"q": ["Match the attacks with their descriptions: (a) Phishing  (b) DoS Attack  (c) Man-in-the-Middle  (d) Spoofing — (i) Flooding network traffic  (ii) Stealing user credentials  (iii) Intercepting communication  (iv) Impersonation attack", "हमलों को उनके विवरण से मिलाइए: (a) Phishing  (b) DoS Attack  (c) Man-in-the-Middle  (d) Spoofing — (i) नेटवर्क ट्रैफ़िक भरना  (ii) यूज़र जानकारी चुराना  (iii) संचार में हस्तक्षेप  (iv) पहचान की नकल"], "opts": [["a–ii, b–i, c–iii, d–iv", ""], ["a–i, b–ii, c–iii, d–iv", ""], ["a–iii, b–i, c–ii, d–iv", ""], ["a–ii, b–iii, c–i, d–iv", ""]], "ans": 0, "exp": ["Phishing steals credentials (ii), DoS floods traffic (i), MitM intercepts communication (iii), Spoofing is impersonation (iv). | Nukta: Attack one-liners: Phishing=fake emails/sites, DoS=flood, MitM=middle interception, Spoofing=fake identity.", "Phishing credentials चुराता है (ii), DoS traffic flood करता है (i), MitM संचार intercept करता है (iii), Spoofing impersonation है (iv)। | Attack one-liners: Phishing=fake emails/sites, DoS=flood, MitM=middle interception, Spoofing=fake identity।"], "src": "Repo: BCI Subject Test-9 (BCI/SCI Batch) — Q3 match (codes recovered)", "sec": "Section A — Security Goals & Attacks", "diff": "medium", "stype": "repository_internal", "style": "match", "tags": ["RSMSSB Informatics Assistant", "SSC Computer Awareness", "RPSC Programmer"]}, {"q": ["A ______ does not perform any destructive action directly; it only consumes system resources to bring the system down.", "एक ______ सीधे कोई विनाशकारी काम नहीं करता; वह सिस्टम को गिराने के लिए सिर्फ system resources खाता है."], "opts": [["Virus", ""], ["Worm", ""], ["Trojan", ""], ["Spyware", ""]], "ans": 1, "exp": ["A worm spreads through the network making copies of itself and eats bandwidth/memory — it does not directly destroy data. | Nukta: HTET 2024 official key (b). फ़र्क: Virus = फ़ाइल में घुसता; Worm = खुद फैलता; Trojan = छिपकर; Spyware = जासूसी.", "Worm अपनी प्रतियाँ बनाकर network में फैलता है और bandwidth/memory खा जाता है — सीधा डेटा नष्ट नहीं करता. | HTET 2024 official key (b). फ़र्क: Virus = फ़ाइल में घुसता; Worm = खुद फैलता; Trojan = छिपकर; Spyware = जासूसी."], "src": "HTET 2024 (via KnowledgeGate solved PYQ bank)", "sec": "Section A — Security Goals & Attacks", "diff": "hard", "stype": "claimed_pyq_unverified", "style": "concept", "tags": ["HTET/PGT"]}, {"q": ["'Junk email' is also known as:", "'Junk email' को और क्या कहते हैं?"], "opts": [["Spam", ""], ["Spoof", ""], ["Sniffer", ""], ["Spool", ""]], "ans": 0, "exp": ["Unwanted bulk email = Spam. It fills the inbox and is often a vehicle for fraud. | Nukta: Spam = junk mail; Spoof = पहचान छिपाना; Sniffer = चोरी से सुनना.", "अवांछित भारी-भरकम email = Spam. यह inbox भर देती है और कई बार धोखाधड़ी का ज़रिया होती है. | Spam = junk mail; Spoof = पहचान छिपाना; Sniffer = चोरी से सुनना."], "src": "RRB NTPC computer banks (via practicemock PYQ set)", "sec": "Section A — Security Goals & Attacks", "diff": "medium", "stype": "claimed_pyq_unverified", "style": "concept", "tags": ["RRB Computer Awareness"]}, {"q": ["Ensuring that data has not been altered in transit relates to which security goal?", "यह सुनिश्चित करना कि data रास्ते में बदला नहीं, किस security goal से है?"], "opts": [["Confidentiality", "Confidentiality"], ["Integrity", "Integrity"], ["Availability", "Availability"], ["Authentication", "Authentication"]], "ans": 1, "exp": ["Integrity = data badla na gaya ho. | Nukta: Confidentiality = chhupana.", "Integrity = data अपरिवर्तित। | Confidentiality = छिपाना।"], "src": "Practice — original (textbook-based)", "sec": "Section A — Security Goals & Attacks", "diff": "hard", "stype": "original_practice", "style": "concept", "tags": ["GATE CS", "UGC-NET 087", "RPSC Programmer", "RPSC ACP/DD", "Practice Set"]}, {"q": ["A program that replicates itself across networks without needing a host file is a:", "वह program जो बिना host file के network पर खुद की प्रतियाँ बनाता है:"], "opts": [["Virus", "Virus"], ["Worm", "Worm"], ["Trojan", "Trojan"], ["Cookie", "Cookie"]], "ans": 1, "exp": ["Worm khud spread hota hai; virus ko host file chahiye. | Nukta: Trojan nakli software ban kar aata hai.", "Worm खुद फैलता है; virus को host चाहिए। | Trojan नक़ली software।"], "src": "Practice — original (textbook-based)", "sec": "Section A — Security Goals & Attacks", "diff": "medium", "stype": "original_practice", "style": "concept", "tags": ["RSMSSB Informatics Assistant", "SSC Computer Awareness", "RPSC Programmer", "Practice Set"]}, {"q": ["Eavesdropping on network traffic is which type of attack?", "Network traffic की जासूसी कौन-सा attack है?"], "opts": [["Passive attack", "Passive attack"], ["Active attack", "Active attack"], ["DoS attack", "DoS attack"], ["Replay attack", "Replay attack"]], "ans": 0, "exp": ["Snoop/sunna = passive (data badalta nahi). | Nukta: Modification = active.", "सुनना = passive। | बदलाव = active।"], "src": "Practice — original (textbook-based)", "sec": "Section A — Security Goals & Attacks", "diff": "medium", "stype": "original_practice", "style": "concept", "tags": ["RSMSSB Informatics Assistant", "SSC Computer Awareness", "RPSC Programmer", "Practice Set"]}, {"q": ["Sending a fake e-mail that appears to come from a bank to steal passwords is called:", "बैंक के नाम से नक़ली e-mail भेजकर password चुराना कहलाता है:"], "opts": [["Phishing", "Phishing"], ["Sniffing", "Sniffing"], ["Spoofing", "Spoofing"], ["Tunneling", "Tunneling"]], "ans": 0, "exp": ["Phishing = nakli identity se secrets churana. | Nukta: Spoofing nakli address; sniffing sunna.", "Phishing = धोखे से चोरी। | Spoofing नक़ली पहचान; sniffing सुनना।"], "src": "Practice — original (textbook-based)", "sec": "Section A — Security Goals & Attacks", "diff": "medium", "stype": "original_practice", "style": "concept", "tags": ["RSMSSB Informatics Assistant", "SSC Computer Awareness", "RPSC Programmer", "Practice Set"]}, {"q": ["Flooding a server with so many requests that legitimate users cannot use it is a:", "Server को इतने requests से भर देना कि असली users न चला सकें:"], "opts": [["DoS attack", "DoS attack"], ["Phishing", "Phishing"], ["Sniffing", "Sniffing"], ["Encryption", "Encryption"]], "ans": 0, "exp": ["Denial of Service = availability par hamla. | Nukta: Confidentiality par interception hota hai.", "DoS = availability पर हमला। | Interception confidentiality पर।"], "src": "Practice — original (textbook-based)", "sec": "Section A — Security Goals & Attacks", "diff": "medium", "stype": "original_practice", "style": "concept", "tags": ["RSMSSB Informatics Assistant", "SSC Computer Awareness", "RPSC Programmer", "Practice Set"]}, {"q": ["A SYN flood (denial-of-service) attack exploits which part of network communication?", "SYN flood (denial-of-service) attack संचार के किस भाग का दुरुपयोग करता है?"], "opts": [["The TCP three-way handshake", "TCP three-way handshake"], ["The DNS resolution process", "DNS resolution process"], ["The ARP cache", "ARP cache"], ["The ICMP echo request", "ICMP echo request"]], "ans": 0, "exp": ["Attacker dheron SYN bhejta hai — server har ek ke liye half-open connection banata hai (SYN-RECV) aur resources khatam ho jaate hain. | Nukta: ARP spoofing = cache poisoning; ICMP flood = echo requests — alag attacks.", "Attacker ढेरों SYN भेजता है — server की half-open connections से resources खत्म होती हैं। | ARP spoofing = cache poisoning; ICMP flood = echo — अलग attacks।"], "src": "Practice — original (textbook-based)", "sec": "Section A — Security Goals & Attacks", "diff": "medium", "stype": "original_practice", "style": "concept", "tags": ["RSMSSB Informatics Assistant", "SSC Computer Awareness", "RPSC Programmer", "Practice Set"]}, {"q": ["A honeypot in network security is:", "Network security में honeypot होता है:"], "opts": [["A decoy system set up to attract attackers and study their activity", "एक प्रलोभन (decoy) system जो attackers को आकर्षित कर उनकी गतिविधि अध्ययन करता है"], ["A firewall rule that blocks all traffic", "सभी traffic रोकने वाला firewall rule"], ["A backup server", "एक backup server"], ["An antivirus quarantine folder", "Antivirus quarantine folder"]], "ans": 0, "exp": ["Honeypot = jaal jaisa fake system/data — attackers usme fass kar apne tools/tarike dikha dete hain; defenders ko intelligence milti hai. | Nukta: Firewall rokta hai; honeypot fasata hai aur seekhata hai.", "Honeypot = जाल जैसा decoy system — attackers अपने तरीके दिखा देते हैं। | Firewall रोकता है; honeypot फँसाता और सिखाता है।"], "src": "Practice — original (textbook-based)", "sec": "Section A — Security Goals & Attacks", "diff": "medium", "stype": "original_practice", "style": "concept", "tags": ["RSMSSB Informatics Assistant", "SSC Computer Awareness", "RPSC Programmer", "Practice Set"]}, {"q": ["A shadow honeypot combines a honeypot with:", "Shadow honeypot जोड़ता है honeypot के साथ:"], "opts": [["An anomaly detection system (suspect traffic is run inside the honeypot)", "Anomaly detection system (संदिग्ध traffic को honeypot के अंदर चलाया जाता है)"], ["A physical lock", "एक भौतिक lock"], ["A DNS sinkhole only", "सिर्फ DNS sinkhole"], ["A load balancer", "एक load balancer"]], "ans": 0, "exp": ["Shadow honeypot: IDS/IPS ka anomaly detector jo kuch block kare, uske shadow copy ko honeypot par chala kar dekhte hain ki attack tha ya false positive — learning + safety dono. | Nukta: Simple honeypot = decoy; shadow = decoy + anomaly detector ka validation.", "Shadow honeypot: anomaly detector की shadow copy को honeypot पर चलाकर जाँच — attack या false positive। | Simple honeypot = decoy; shadow = decoy + anomaly detector।"], "src": "Practice — original (textbook-based)", "sec": "Section A — Security Goals & Attacks", "diff": "medium", "stype": "original_practice", "style": "concept", "tags": ["RSMSSB Informatics Assistant", "SSC Computer Awareness", "RPSC Programmer", "Practice Set"]}, {"q": ["The text that gets transformed using a cipher algorithm is called:", "Cipher algorithm से जिस text को बदला जाता है उसे क्या कहते हैं?"], "opts": [["Complex Text", ""], ["Transformed Text", ""], ["Plain Text", ""], ["Scalar Text", ""]], "ans": 2, "exp": ["The INPUT to the cipher is the plaintext; after transformation it becomes ciphertext. | Nukta: Cryptography flow: Plain text --(cipher + key)--> Ciphertext --(decipher + key)--> Plain text.", "Cipher का INPUT plaintext है; बदलने के बाद वह ciphertext बनता है। | Cryptography flow: Plain text --(cipher + key)--> Ciphertext --(decipher + key)--> Plain text।"], "src": "Repo: BCI Subject Test-9 (BCI/SCI Batch) — Q9", "sec": "Section B — Cryptography", "diff": "easy", "stype": "repository_internal", "style": "concept", "tags": ["SSC Computer Awareness", "RSMSSB Informatics Assistant", "JNV TAT"]}, {"q": ["Which statement about plaintext, ciphertext and key is MOST accurate?", "Plaintext, ciphertext और key के बारे में कौन-सा कथन सबसे सही है?"], "opts": [["Plaintext is generated after decryption using a public key", ""], ["Ciphertext is the original readable message", ""], ["Plaintext is transformed into ciphertext using an algorithm and a key", ""], ["Ciphertext and plaintext are always of the same length", ""]], "ans": 2, "exp": ["Encryption transforms plaintext into ciphertext using a cipher algorithm together with a key — this is the precise description. | Nukta: Remember the 3 objects: plaintext (readable), ciphertext (scrambled), key (secret parameter). Encryption = f(plaintext, key).", "Encryption एक cipher algorithm और key के साथ plaintext को ciphertext में बदलता है — यही सटीक विवरण है। | 3 objects याद रखें: plaintext (पढ़ने योग्य), ciphertext (scrambled), key (गुप्त parameter)। Encryption = f(plaintext, key)।"], "src": "Repo: BCI Subject Test-9 (BCI/SCI Batch) — Q10", "sec": "Section B — Cryptography", "diff": "medium", "stype": "repository_internal", "style": "concept", "tags": ["RSMSSB Informatics Assistant", "SSC Computer Awareness", "RPSC Programmer"]}, {"q": ["Which of the following uses the SAME key for encryption and decryption?", "निम्न में से कौन-सा encryption और decryption के लिए एक ही key उपयोग करता है?"], "opts": [["Symmetric key cipher", ""], ["Asymmetric key cipher", ""], ["Hash function", ""], ["Digital signature", ""]], "ans": 0, "exp": ["Symmetric cryptography uses one shared secret key for both encryption and decryption (AES, DES, Blowfish). | Nukta: Symmetric = 1 key (fast). Asymmetric = key pair (public+private, slow). Hash = one-way digest. Signature = private-sign/public-verify.", "Symmetric cryptography encryption और decryption दोनों के लिए एक ही shared secret key उपयोग करता है (AES, DES, Blowfish)। | Symmetric = 1 key (तेज़)। Asymmetric = key pair (public+private, धीमा)। Hash = one-way digest। Signature = private-sign/public-verify।"], "src": "Repo: BCI_SCI Subject Test-01 (CN and Security)", "sec": "Section B — Cryptography", "diff": "medium", "stype": "repository_internal", "style": "concept", "tags": ["RSMSSB Informatics Assistant", "SSC Computer Awareness", "RPSC Programmer"]}, {"q": ["Which of the following uses a PAIR of keys (public and private)?", "निम्न में से कौन-सा keys की एक जोड़ी (public और private) उपयोग करता है?"], "opts": [["Symmetric cipher", ""], ["Asymmetric cipher", ""], ["DES", ""], ["AES", ""]], "ans": 1, "exp": ["Asymmetric (public-key) cryptography uses a mathematically linked key pair — public key to encrypt, private key to decrypt (RSA, ECC, Diffie-Hellman). | Nukta: Public-key examples: RSA, Diffie-Hellman, ECC, DSA. Symmetric: DES, 3DES, AES, Blowfish, RC4.", "Asymmetric (public-key) cryptography गणितीय रूप से जुड़ी key pair उपयोग करता है — encrypt के लिए public key, decrypt के लिए private key (RSA, ECC, Diffie-Hellman)। | Public-key examples: RSA, Diffie-Hellman, ECC, DSA। Symmetric: DES, 3DES, AES, Blowfish, RC4।"], "src": "Repo: BCI_SCI Subject Test-01 (CN and Security)", "sec": "Section B — Cryptography", "diff": "medium", "stype": "repository_internal", "style": "concept", "tags": ["RSMSSB Informatics Assistant", "SSC Computer Awareness", "RPSC Programmer"]}, {"q": ["Which is FASTER in encryption and decryption?", "Encryption और decryption में कौन-सा तेज़ है?"], "opts": [["Symmetric key cipher", ""], ["Asymmetric key cipher", ""], ["Cannot decide", ""], ["None of these", ""]], "ans": 0, "exp": ["Symmetric ciphers (AES/DES) are orders of magnitude faster than asymmetric ones (RSA) — that's why bulk data uses symmetric encryption. | Nukta: Speed: Symmetric >> Asymmetric. Hybrid systems (TLS/PGP) use asymmetric KEYS to exchange a symmetric SESSION key.", "Symmetric ciphers (AES/DES), asymmetric (RSA) से कई गुना तेज़ होते हैं — इसीलिए bulk data में symmetric encryption होती है। | Speed: Symmetric >> Asymmetric। Hybrid systems (TLS/PGP) asymmetric KEYS से symmetric SESSION key का आदान-प्रदान करती हैं।"], "src": "Repo: BCI_SCI Subject Test-01 (CN and Security)", "sec": "Section B — Cryptography", "diff": "medium", "stype": "repository_internal", "style": "concept", "tags": ["RSMSSB Informatics Assistant", "SSC Computer Awareness", "RPSC Programmer"]}, {"q": ["What is the main disadvantage of symmetric key encryption?", "Symmetric key encryption की मुख्य कमी क्या है?"], "opts": [["It is very slow", ""], ["Key distribution is difficult", ""], ["It uses two keys", ""], ["It cannot encrypt text", ""]], "ans": 1, "exp": ["Both sides must share the SAME secret key securely — key distribution over an insecure channel is the classic problem. | Nukta: Symmetric weakness = key distribution (n users → n(n-1)/2 keys). Asymmetric weakness = slow + key authenticity (certificates).", "दोनों पक्षों को एक ही secret key सुरक्षित रूप से साझा करनी होती है — insecure channel पर key distribution ही classic समस्या है। | Symmetric कमज़ोरी = key distribution (n users → n(n-1)/2 keys)। Asymmetric कमज़ोरी = धीमा + key authenticity (certificates)।"], "src": "Repo: BCI_SCI Subject Test-01 (CN and Security)", "sec": "Section B — Cryptography", "diff": "medium", "stype": "repository_internal", "style": "concept", "tags": ["RSMSSB Informatics Assistant", "SSC Computer Awareness", "RPSC Programmer"]}, {"q": ["Public key is used to:", "Public key का उपयोग किसके लिए होता है?"], "opts": [["Encrypt the data", ""], ["Decrypt the data", ""], ["Both encrypt and decrypt", ""], ["Generate session keys only", ""]], "ans": 0, "exp": ["In public-key cryptography anyone can use the recipient's PUBLIC key to encrypt; only the recipient's PRIVATE key can decrypt. | Nukta: Encrypt with public → decrypt with private. SIGN with private → verify with public. Exam asks both directions!", "Public-key cryptography में कोई भी प्राप्तकर्ता की PUBLIC key से encrypt कर सकता है; केवल प्राप्तकर्ता की PRIVATE key से decrypt होता है। | Encrypt public से → decrypt private से। SIGN private से → verify public से। Exam दोनों दिशाएँ पूछता है!"], "src": "Repo: BCI_SCI Subject Test-01 (CN and Security)", "sec": "Section B — Cryptography", "diff": "hard", "stype": "repository_internal", "style": "concept", "tags": ["GATE CS", "UGC-NET 087", "RPSC Programmer", "RPSC ACP/DD"]}, {"q": ["In public-key cryptography, a message encrypted with the public key can only be decrypted by:", "Public-key cryptography में public key से encrypt किया संदेश केवल किसके द्वारा decrypt हो सकता है?"], "opts": [["Another public key", ""], ["The same public key", ""], ["The private key corresponding to that public key", ""], ["A session key", ""]], "ans": 2, "exp": ["Only the matching private key of the key pair can decrypt what the public key encrypted. | Nukta: Public/private are mathematically paired — like a lock (public) and its only key (private).", "केवल उस key pair की मेल खाती private key ही public key से encrypt किए गए संदेश को decrypt कर सकती है। | Public/private गणितीय रूप से जुड़े हैं — एक ताला (public) और उसकी एकमात्र चाबी (private) की तरह।"], "src": "Repo: BCI_SCI Subject Test-01 (CN and Security)", "sec": "Section B — Cryptography", "diff": "medium", "stype": "repository_internal", "style": "concept", "tags": ["RSMSSB Informatics Assistant", "SSC Computer Awareness", "RPSC Programmer"]}, {"q": ["Which statement about symmetric and asymmetric cryptography is TRUE?", "Symmetric और asymmetric cryptography के बारे में कौन-सा कथन सही है?"], "opts": [["Symmetric cryptography provides authentication", ""], ["Asymmetric cryptography is faster than symmetric", ""], ["Symmetric cryptography requires secure key exchange", ""], ["Both use two different keys", ""]], "ans": 2, "exp": ["Symmetric cryptography requires a SECURE key exchange between the parties — that is its defining practical challenge. | Nukta: True: symmetric needs secure key exchange. False: symmetric does not inherently authenticate; asymmetric is slower; symmetric uses ONE key.", "Symmetric cryptography के लिए पक्षों के बीच सुरक्षित key exchange आवश्यक है — यही इसकी मुख्य व्यावहारिक चुनौती है। | सही: symmetric को secure key exchange चाहिए। गलत: symmetric स्वयं authentication नहीं देता; asymmetric धीमा; symmetric एक key उपयोग करता है।"], "src": "Repo: BCI_SCI Subject Test-01 (CN and Security) — Q33", "sec": "Section B — Cryptography", "diff": "hard", "stype": "repository_internal", "style": "statement", "tags": ["GATE CS", "UGC-NET 087", "RPSC Programmer", "RPSC ACP/DD"]}, {"q": ["Data Encryption Standard (DES) is a:", "Data Encryption Standard (DES) क्या है?"], "opts": [["Block cipher", ""], ["Stream cipher", ""], ["Bit cipher", ""], ["Byte cipher", ""]], "ans": 0, "exp": ["DES encrypts data in 64-bit blocks using a 56-bit key — a classic symmetric BLOCK cipher. | Nukta: DES = 64-bit block, 56-bit key (symmetric). AES = 128-bit block. RC4 = stream cipher.", "DES data को 64-bit blocks में 56-bit key से encrypt करता है — एक classic symmetric BLOCK cipher। | DES = 64-bit block, 56-bit key (symmetric)। AES = 128-bit block। RC4 = stream cipher।"], "src": "Repo: BCI_SCI Subject Test-01 (CN and Security)", "sec": "Section B — Cryptography", "diff": "medium", "stype": "repository_internal", "style": "concept", "tags": ["RSMSSB Informatics Assistant", "SSC Computer Awareness", "RPSC Programmer"]}, {"q": ["What is the key length of AES-256 encryption?", "AES-256 encryption की key length कितनी है?"], "opts": [["128 bits", ""], ["192 bits", ""], ["256 bits", ""], ["512 bits", ""]], "ans": 2, "exp": ["AES-256 uses a 256-bit key (the number in the name is the key length). | Nukta: AES variants: AES-128, AES-192, AES-256 (key sizes). Block size is always 128 bits.", "AES-256 में 256-bit key उपयोग होती है (नाम में संख्या key length है)। | AES variants: AES-128, AES-192, AES-256 (key sizes)। Block size हमेशा 128 bits।"], "src": "Repo: BCI_SCI Subject Test-01 (CN and Security)", "sec": "Section B — Cryptography", "diff": "hard", "stype": "repository_internal", "style": "concept", "tags": ["GATE CS", "UGC-NET 087", "RPSC Programmer", "RPSC ACP/DD"]}, {"q": ["Which cipher method encrypts one bit or byte at a time?", "कौन-सी cipher method एक बार में एक bit या byte encrypt करती है?"], "opts": [["Block cipher", ""], ["Stream cipher", ""], ["Substitution cipher", ""], ["Transposition cipher", ""]], "ans": 1, "exp": ["A stream cipher encrypts the data one bit (or byte) at a time as a continuous stream (e.g., RC4). | Nukta: Stream = 1 bit/byte at a time (RC4, A5/1). Block = fixed-size blocks (DES/AES). Substitution/Transposition = classical techniques.", "Stream cipher data को एक समय में एक bit (या byte) encrypt करती है, एक निरंतर धारा के रूप में (जैसे RC4)। | Stream = 1 bit/byte at a time (RC4, A5/1)। Block = fixed-size blocks (DES/AES)। Substitution/Transposition = classical techniques।"], "src": "Repo: BCI_SCI Subject Test-01 (CN and Security)", "sec": "Section B — Cryptography", "diff": "medium", "stype": "repository_internal", "style": "concept", "tags": ["RSMSSB Informatics Assistant", "SSC Computer Awareness", "RPSC Programmer"]}, {"q": ["Which of the following statements is FALSE?", "निम्न में से कौन-सा कथन गलत है?"], "opts": [["AES is a block cipher", ""], ["RSA is a symmetric cipher", ""], ["Diffie-Hellman is used for key exchange", ""], ["DES is symmetric", ""]], "ans": 1, "exp": ["RSA is an ASYMMETRIC (public-key) cipher — the statement 'RSA is symmetric' is false. | Nukta: False-statement MCQs: check each. AES=block ✓, RSA=asymmetric ✗, DH=key exchange ✓, DES=symmetric ✓.", "RSA एक ASYMMETRIC (public-key) cipher है — 'RSA symmetric है' कथन गलत है। | False-statement MCQs: हर एक जाँचें। AES=block ✓, RSA=asymmetric ✗, DH=key exchange ✓, DES=symmetric ✓।"], "src": "Repo: BCI_SCI Subject Test-01 (CN and Security)", "sec": "Section B — Cryptography", "diff": "hard", "stype": "repository_internal", "style": "statement", "tags": ["GATE CS", "UGC-NET 087", "RPSC Programmer", "RPSC ACP/DD"]}, {"q": ["In the digital signature technique, when the whole message is signed using an asymmetric key, the receiver uses:", "Digital signature technique में, जब पूरा संदेश asymmetric key से sign होता है, तो प्राप्तकर्ता उपयोग करता है:"], "opts": [["Her or his own public key", ""], ["Her or his own private key", ""], ["The sender's public key", ""], ["None of these", ""]], "ans": 2, "exp": ["The sender signs with their PRIVATE key; the receiver verifies the signature using the SENDER'S PUBLIC key. | Nukta: Signature direction: SIGN with private → VERIFY with public. Encryption direction: ENCRYPT with public → DECRYPT with private.", "भेजने वाला अपनी PRIVATE key से sign करता है; प्राप्तकर्ता भेजने वाले की PUBLIC key से signature सत्यापित करता है। | Signature दिशा: private से SIGN → public से VERIFY। Encryption दिशा: public से ENCRYPT → private से DECRYPT।"], "src": "Repo: BCI Subject Test-9 (BCI/SCI Batch)", "sec": "Section B — Cryptography", "diff": "easy", "stype": "repository_internal", "style": "concept", "tags": ["SSC Computer Awareness", "RSMSSB Informatics Assistant", "JNV TAT"]}, {"q": ["The Caesar Cipher is an example of which cryptographic technique?", "Caesar Cipher किस cryptographic technique का उदाहरण है?"], "opts": [["Transposition cipher", ""], ["Substitution cipher", ""], ["Stream cipher", ""], ["Block cipher", ""]], "ans": 1, "exp": ["The Caesar cipher replaces each letter by another a fixed number of places down the alphabet — a classical SUBSTITUTION cipher. | Nukta: Classical types: Substitution (Caesar, Playfair) = replace; Transposition (Rail fence) = rearrange.", "Caesar cipher में हर अक्षर को वर्णमाला में कुछ स्थान आगे वाले अक्षर से बदला जाता है — एक classical SUBSTITUTION cipher। | Classical types: Substitution (Caesar, Playfair) = replace; Transposition (Rail fence) = rearrange।"], "src": "Repo: BCI_SCI Subject Test-01 (CN and Security)", "sec": "Section B — Cryptography", "diff": "medium", "stype": "repository_internal", "style": "concept", "tags": ["RSMSSB Informatics Assistant", "SSC Computer Awareness", "RPSC Programmer"]}, {"q": ["The process of detecting hidden data inside a file is known as:", "किसी file के भीतर छिपे data का पता लगाने की प्रक्रिया को क्या कहते हैं?"], "opts": [["Cryptanalysis", ""], ["Steganalysis", ""], ["Data mining", ""], ["Steganography", ""]], "ans": 1, "exp": ["Steganalysis is the art of detecting/extracting data hidden by steganography. | Nukta: Steganography = HIDING data (cover file). Steganalysis = DETECTING it. Cryptography = scrambling it.", "Steganalysis, steganography से छिपाए गए data का पता लगाने/निकालने की कला है। | Steganography = data छिपाना (cover file)। Steganalysis = पता लगाना। Cryptography = scramblइंग।"], "src": "Repo: BCI_SCI Subject Test-01 (CN and Security)", "sec": "Section B — Cryptography", "diff": "medium", "stype": "repository_internal", "style": "concept", "tags": ["RSMSSB Informatics Assistant", "SSC Computer Awareness", "RPSC Programmer"]}, {"q": ["What is the output of a steganography process called?", "Steganography प्रक्रिया के output को क्या कहते हैं?"], "opts": [["Ciphertext", ""], ["Stego-object", ""], ["Encoded file", ""], ["Key file", ""]], "ans": 1, "exp": ["The carrier file that now contains the hidden message is called the stego-object. | Nukta: Stego terms: cover file (original carrier), secret message (hidden data), stego-object (result).", "वह carrier file जिसमें अब छिपा संदेश है, stego-object कहलाती है। | Stego terms: cover file (original carrier), secret message (hidden data), stego-object (result)।"], "src": "Repo: BCI_SCI Subject Test-01 (CN and Security)", "sec": "Section B — Cryptography", "diff": "medium", "stype": "repository_internal", "style": "concept", "tags": ["RSMSSB Informatics Assistant", "SSC Computer Awareness", "RPSC Programmer"]}, {"q": ["In steganography, the file used to hide the secret data is called:", "Steganography में secret data छिपाने के लिए जिस file का उपयोग होता है उसे क्या कहते हैं?"], "opts": [["Secret file", ""], ["Cover file", ""], ["Cipher file", ""], ["Key file", ""]], "ans": 1, "exp": ["The innocent-looking carrier (image/audio/document) that hides the secret data is called the cover file. | Nukta: Cover file = the disguise. Secret message = hidden data. Stego-object = cover + secret after embedding.", "वह मासूम दिखने वाली carrier (image/audio/document) जो secret data छिपाती है, cover file कहलाती है। | Cover file = छद्म वेश। Secret message = छिपा data। Stego-object = embedding के बाद cover + secret।"], "src": "Subject Test Solution-1 Part-2 (CN & Security) slides", "sec": "Section B — Cryptography", "diff": "medium", "stype": "repository_internal", "style": "concept", "tags": ["RSMSSB Informatics Assistant", "SSC Computer Awareness", "RPSC Programmer"]}, {"q": ["Which of the following is an example of asymmetric encryption?", "निम्न में से कौन-सा asymmetric encryption का उदाहरण है?"], "opts": [["AES", ""], ["DES", ""], ["RSA", ""], ["Blowfish", ""]], "ans": 2, "exp": ["RSA is the classic public-key (asymmetric) algorithm; AES, DES and Blowfish are all symmetric. | Nukta: Asymmetric = RSA, ECC, Diffie-Hellman, DSA. Symmetric = DES, 3DES, AES, Blowfish, RC4, IDEA.", "RSA classic public-key (asymmetric) algorithm है; AES, DES और Blowfish सब symmetric हैं। | Asymmetric = RSA, ECC, Diffie-Hellman, DSA। Symmetric = DES, 3DES, AES, Blowfish, RC4, IDEA।"], "src": "SSC CGL Tier-2 repeated Qs (via Oliveboard) · also BCI_SCI ST-01", "sec": "Section B — Cryptography", "diff": "medium", "stype": "repository_internal", "style": "concept", "tags": ["SSC Computer Awareness"]}, {"q": ["The data to be encrypted at the sender's site is called ______ and the data to be decrypted at the receiver's end is called ______.", "Sender की ओर encrypt किए जाने वाले data को ______ और receiver की ओर decrypt किए जाने वाले data को ______ कहते हैं."], "opts": [["Secret key, public key", ""], ["Public key, secret key", ""], ["Plain text, cipher text", ""], ["Cipher text, plain text", ""]], "ans": 2, "exp": ["मूल data = Plain text; encrypt होने के बाद = Cipher text. Receiver पर cipher text decrypt होकर फिर plain text बनता है. | Nukta: याद रखो: Plain (सादा) → encrypt → Cipher (गूँथा) → decrypt → Plain.", "मूल data = Plain text; encrypt होने के बाद = Cipher text. Receiver पर cipher text decrypt होकर फिर plain text बनता है. | याद रखो: Plain (सादा) → encrypt → Cipher (गूँथा) → decrypt → Plain."], "src": "SBI PO Computer Awareness PYQ (via bankersadda)", "sec": "Section B — Cryptography", "diff": "medium", "stype": "claimed_pyq_unverified", "style": "concept", "tags": ["IBPS Computer Awareness"]}, {"q": ["Suppose everyone in a group of N people wants to communicate secretly with the N−1 others using a symmetric-key cryptographic system. The number of keys required in the system as a whole is:", "मान लीजिए N लोगों के समूह में हर व्यक्ति बाकी N−1 लोगों से symmetric-key cryptographic system से गुप्त बातचीत करना चाहता है. कुल कितने keys चाहिए होंगी?"], "opts": [["2N", ""], ["N(N − 1)", ""], ["N(N − 1)/2", ""], ["(N − 1)²", ""]], "ans": 2, "exp": ["Symmetric keys are shared in pairs — one key per pair. N people need N(N−1)/2 pairs. | Nukta: GATE key (c). Public-key में यह समस्या नहीं — इसीलिए hybrid systems आए.", "Symmetric keys जोड़ों में बँटती हैं — हर जोड़े की एक key. N लोगों के जोड़े = N(N−1)/2. | GATE key (c). Public-key में यह समस्या नहीं — इसीलिए hybrid systems आए."], "src": "GATE CS PYQ (via examprev)", "sec": "Section B — Cryptography", "diff": "hard", "stype": "claimed_pyq_unverified", "style": "concept", "tags": ["GATE CS"]}, {"q": ["Which algorithm is symmetric?", "निम्न में से कौन symmetric algorithm है?"], "opts": [["RSA", "RSA"], ["AES", "AES"], ["Diffie-Hellman", "Diffie-Hellman"], ["ECC", "ECC"]], "ans": 1, "exp": ["AES symmetric; RSA/DH/ECC asymmetric. | Nukta: Asymmetric mein key pair hota hai.", "AES symmetric; बाक़ी asymmetric। | Asymmetric में key pair।"], "src": "Practice — original (textbook-based)", "sec": "Section B — Cryptography", "diff": "medium", "stype": "original_practice", "style": "concept", "tags": ["RSMSSB Informatics Assistant", "SSC Computer Awareness", "RPSC Programmer", "Practice Set"]}, {"q": ["A hash function is mainly used to provide:", "Hash function मुख्यतः देता है:"], "opts": [["Confidentiality", "Confidentiality"], ["Integrity", "Integrity"], ["Availability", "Availability"], ["Compression", "Compression"]], "ans": 1, "exp": ["Hash digest se data change detect (integrity). | Nukta: Encryption confidentiality deta hai.", "Hash से परिवर्तन पता (integrity)। | Encryption confidentiality।"], "src": "Practice — original (textbook-based)", "sec": "Section B — Cryptography", "diff": "medium", "stype": "original_practice", "style": "concept", "tags": ["RSMSSB Informatics Assistant", "SSC Computer Awareness", "RPSC Programmer", "Practice Set"]}, {"q": ["A digital signature provides:", "Digital signature देता है:"], "opts": [["Confidentiality only", "केवल confidentiality"], ["Authentication and non-repudiation", "Authentication और non-repudiation"], ["Availability", "Availability"], ["Compression", "Compression"]], "ans": 1, "exp": ["Private key se sign — pehchaan + inkar na mumkin. | Nukta: Encryption confidentiality.", "Private key से sign — पहचान + non-repudiation। | Encryption confidentiality।"], "src": "Practice — original (textbook-based)", "sec": "Section B — Cryptography", "diff": "medium", "stype": "original_practice", "style": "concept", "tags": ["RSMSSB Informatics Assistant", "SSC Computer Awareness", "RPSC Programmer", "Practice Set"]}, {"q": ["DES is an example of which type of cipher?", "DES किस प्रकार का cipher है?"], "opts": [["Stream cipher", "Stream cipher"], ["Block cipher", "Block cipher"], ["Asymmetric cipher", "Asymmetric cipher"], ["Hash function", "Hash function"]], "ans": 1, "exp": ["DES/AES block ciphers (64/128-bit blocks); RC4 stream. | Nukta: RC4 stream cipher hai.", "DES/AES block; RC4 stream। | RC4 stream।"], "src": "Practice — original (textbook-based)", "sec": "Section B — Cryptography", "diff": "medium", "stype": "original_practice", "style": "concept", "tags": ["RSMSSB Informatics Assistant", "SSC Computer Awareness", "RPSC Programmer", "Practice Set"]}, {"q": ["The AES symmetric encryption standard supports key sizes of:", "AES symmetric encryption standard की key sizes होती हैं:"], "opts": [["128, 192 and 256 bits", "128, 192 और 256 bits"], ["56, 128 and 256 bits", "56, 128 और 256 bits"], ["1024, 2048 and 4096 bits", "1024, 2048 और 4096 bits"], ["64, 128 and 192 bits", "64, 128 और 192 bits"]], "ans": 0, "exp": ["AES (Rijndael): 128/192/256-bit keys, 128-bit blocks; DES = 56-bit key (purana); RSA 1024+ = asymmetric. | Nukta: Symmetric = chhoti keys (128-256); asymmetric = badi keys (1024+).", "AES: 128/192/256-bit keys, 128-bit blocks; DES = 56-bit; RSA 1024+ = asymmetric। | Symmetric = छोटी keys; asymmetric = बड़ी keys।"], "src": "Practice — original (textbook-based)", "sec": "Section B — Cryptography", "diff": "hard", "stype": "original_practice", "style": "concept", "tags": ["GATE CS", "UGC-NET 087", "RPSC Programmer", "RPSC ACP/DD", "Practice Set"]}, {"q": ["What is the advantage of setting up a DMZ (Demilitarized Zone) using a firewall?", "Firewall का उपयोग करके DMZ (Demilitarized Zone) बनाने का क्या लाभ है?"], "opts": [["To create multiple zones of trust", ""], ["Load balancing on the server", ""], ["Improving network performance", ""], ["Bringing internet service into a home", ""]], "ans": 0, "exp": ["A DMZ creates separate trust zones — public servers (web/mail) sit in the DMZ so attackers don't directly reach the internal trusted network. | Nukta: Official RPSC key. DMZ = buffer zone between untrusted Internet and trusted LAN (3 zones: external / DMZ / internal).", "DMZ अलग trust zones बनाता है — public servers (web/mail) DMZ में रहते हैं ताकि attackers सीधे internal trusted network तक न पहुँचें। | Official RPSC key। DMZ = untrusted Internet और trusted LAN के बीच buffer zone (3 zones: external / DMZ / internal)।"], "src": "RPSC Programmer 2024 Paper-1 (official key)", "sec": "Section C — Firewalls, IPSec & Security Protocols", "diff": "hard", "stype": "verified_official_pyq", "style": "concept", "tags": ["RPSC Programmer"]}, {"q": ["Match the security mechanisms with their OSI layers: (a) Firewall  (b) Digital Signature  (c) MAC Filtering  (d) Port-based Filtering — (i) Network Layer  (ii) Application Layer  (iii) Data Link Layer  (iv) Transport Layer", "Security mechanisms को OSI layers से मिलाइए: (a) Firewall  (b) Digital Signature  (c) MAC Filtering  (d) Port-based Filtering — (i) Network Layer  (ii) Application Layer  (iii) Data Link Layer  (iv) Transport Layer"], "opts": [["a–i, b–ii, c–iii, d–iv", ""], ["a–ii, b–i, c–iii, d–iv", ""], ["a–iv, b–ii, c–i, d–iii", ""], ["a–i, b–iii, c–ii, d–iv", ""]], "ans": 0, "exp": ["Firewall rules work at the network layer (IP), digital signatures are application-level, MAC filtering is data-link, and port filtering is transport-level (TCP/UDP ports). | Nukta: Mechanism-layers: Firewall L3/L4 (IP), Port filter L4, MAC filter L2, Digital signature L7. Packet-filtering firewall = L3/L4.", "Firewall rules network layer (IP) पर, digital signatures application level पर, MAC filtering data-link पर, और port filtering transport level (TCP/UDP ports) पर काम करते हैं। | Mechanism-layers: Firewall L3/L4 (IP), Port filter L4, MAC filter L2, Digital signature L7। Packet-filtering firewall = L3/L4।"], "src": "Repo: BCI Subject Test-9 (BCI/SCI Batch) — Q4 match (codes recovered)", "sec": "Section C — Firewalls, IPSec & Security Protocols", "diff": "medium", "stype": "repository_internal", "style": "match", "tags": ["RSMSSB Informatics Assistant", "SSC Computer Awareness", "RPSC Programmer"]}, {"q": ["Match the security protocols with their OSI layers: (a) IPSec  (b) SSL/TLS  (c) PGP  (d) WPA2 — (i) Application Layer  (ii) Network Layer  (iii) Transport/Presentation Layer  (iv) Data Link Layer (Wi-Fi)", "Security protocols को OSI layers से मिलाइए: (a) IPSec  (b) SSL/TLS  (c) PGP  (d) WPA2 — (i) Application Layer  (ii) Network Layer  (iii) Transport/Presentation Layer  (iv) Data Link Layer (Wi-Fi)"], "opts": [["a–ii, b–iii, c–i, d–iv", ""], ["a–ii, b–i, c–iii, d–iv", ""], ["a–iii, b–ii, c–i, d–iv", ""], ["a–i, b–ii, c–iii, d–iv", ""]], "ans": 0, "exp": ["IPSec secures at the network layer (L3), SSL/TLS at transport/presentation, PGP is an application-layer mail security tool, and WPA2 protects Wi-Fi at the data-link layer. | Nukta: Protocol layers: IPSec L3, SSL/TLS L4-7 (exam: transport/presentation), PGP L7, WPA2 L2, Kerberos L7.", "IPSec network layer (L3) पर, SSL/TLS transport/presentation पर, PGP application-layer mail security tool है, और WPA2 Wi-Fi को data-link layer पर सुरक्षित करता है। | Protocol layers: IPSec L3, SSL/TLS L4-7 (exam: transport/presentation), PGP L7, WPA2 L2, Kerberos L7।"], "src": "Repo: BCI Subject Test-9 (BCI/SCI Batch) — Q1 match (codes recovered)", "sec": "Section C — Firewalls, IPSec & Security Protocols", "diff": "medium", "stype": "repository_internal", "style": "match", "tags": ["RSMSSB Informatics Assistant", "SSC Computer Awareness", "RPSC Programmer"]}, {"q": ["IPSec is MOST commonly used to implement:", "IPSec मुख्यतः किसके लिए उपयोग होता है?"], "opts": [["Secure email", ""], ["Secure web browsing", ""], ["Virtual Private Network (VPN)", ""], ["Wireless security", ""]], "ans": 2, "exp": ["IPSec provides encrypted tunnels over the internet — the foundation of most site-to-site and remote-access VPNs. | Nukta: IPSec = VPN tunneling (ESP/AH). Secure email = PGP/SMIME. Secure web = SSL/TLS. Wireless = WPA2.", "IPSec internet पर encrypted tunnels देता है — अधिकांश site-to-site और remote-access VPNs की नींव। | IPSec = VPN tunneling (ESP/AH)। Secure email = PGP/SMIME। Secure web = SSL/TLS। Wireless = WPA2।"], "src": "Repo: BCI Subject Test-9 (BCI/SCI Batch)", "sec": "Section C — Firewalls, IPSec & Security Protocols", "diff": "easy", "stype": "repository_internal", "style": "concept", "tags": ["SSC Computer Awareness", "RSMSSB Informatics Assistant", "JNV TAT"]}, {"q": ["IPSec operates in which mode(s)?", "IPSec किस/किन mode(s) में काम करता है?"], "opts": [["Transport mode only", ""], ["Tunnel mode only", ""], ["Both transport mode and tunnel mode", ""], ["Application mode", ""]], "ans": 2, "exp": ["IPSec has two modes — transport mode (protects the payload, end-to-end) and tunnel mode (protects the whole IP packet, gateway-to-gateway). | Nukta: IPSec modes: Transport (payload only, host-to-host) & Tunnel (full packet, gateway-to-gateway/VPN).", "IPSec के दो modes हैं — transport mode (payload सुरक्षित, end-to-end) और tunnel mode (पूरा IP packet सुरक्षित, gateway-to-gateway)। | IPSec modes: Transport (केवल payload, host-to-host) और Tunnel (पूरा packet, gateway-to-gateway/VPN)।"], "src": "Repo: BCI Subject Test-9 (BCI/SCI Batch)", "sec": "Section C — Firewalls, IPSec & Security Protocols", "diff": "medium", "stype": "repository_internal", "style": "concept", "tags": ["RSMSSB Informatics Assistant", "SSC Computer Awareness", "RPSC Programmer"]}, {"q": ["In IPSec Tunnel mode:", "IPSec Tunnel mode में:"], "opts": [["Only the payload is encrypted", ""], ["Only the header is encrypted", ""], ["The entire IP packet is encrypted", ""], ["No encryption is used", ""]], "ans": 2, "exp": ["Tunnel mode encrypts the ENTIRE original IP packet (header + payload) and adds a new header — used for VPN gateways. | Nukta: Tunnel = whole packet + new header (gateway VPN). Transport = payload only (host-to-host).", "Tunnel mode पूरे original IP packet (header + payload) को encrypt करके नया header जोड़ता है — VPN gateways के लिए उपयोग। | Tunnel = पूरा packet + नया header (gateway VPN)। Transport = केवल payload (host-to-host)।"], "src": "Repo: BCI Subject Test-9 (BCI/SCI Batch)", "sec": "Section C — Firewalls, IPSec & Security Protocols", "diff": "easy", "stype": "repository_internal", "style": "concept", "tags": ["SSC Computer Awareness", "RSMSSB Informatics Assistant", "JNV TAT"]}, {"q": ["Which mode of IPSec provides end-to-end security between two hosts?", "IPSec का कौन-सा mode दो hosts के बीच end-to-end security देता है?"], "opts": [["Transport mode", ""], ["Tunnel mode", ""], ["Static mode", ""], ["Gateway mode", ""]], "ans": 0, "exp": ["Transport mode secures communication directly between two hosts (end-to-end) — only the payload is protected. | Nukta: End-to-end (host↔host) = Transport mode. Gateway↔gateway (VPN) = Tunnel mode.", "Transport mode दो hosts के बीच सीधे संचार सुरक्षित करता है (end-to-end) — केवल payload सुरक्षित होता है। | End-to-end (host↔host) = Transport mode। Gateway↔gateway (VPN) = Tunnel mode।"], "src": "Repo: CN Topic Test 5 (UNIT TEST-5)", "sec": "Section C — Firewalls, IPSec & Security Protocols", "diff": "medium", "stype": "repository_internal", "style": "concept", "tags": ["RSMSSB Informatics Assistant", "SSC Computer Awareness", "RPSC Programmer"]}, {"q": ["The SSL/TLS handshake protocol is mainly used for:", "SSL/TLS handshake protocol मुख्यतः किसके लिए उपयोग होता है?"], "opts": [["Data encryption", ""], ["Data compression", ""], ["Key exchange and authentication", ""], ["Packet routing", ""]], "ans": 2, "exp": ["The handshake negotiates cipher suites, authenticates the server (certificates) and exchanges keys for the session. | Nukta: TLS parts: Handshake = keys+authentication; Record = encryption+integrity. HTTPS = HTTP over TLS (port 443).", "Handshake cipher suites का निर्णय करता है, server को authenticate करता है (certificates) और session के लिए keys का आदान-प्रदान करता है। | TLS parts: Handshake = keys+authentication; Record = encryption+integrity। HTTPS = HTTP over TLS (port 443)।"], "src": "Repo: BCI Subject Test-9 (BCI/SCI Batch)", "sec": "Section C — Firewalls, IPSec & Security Protocols", "diff": "easy", "stype": "repository_internal", "style": "concept", "tags": ["SSC Computer Awareness", "RSMSSB Informatics Assistant", "JNV TAT"]}, {"q": ["Which of the following is used in HTTPS for encryption?", "HTTPS में encryption के लिए निम्न में से क्या उपयोग होता है?"], "opts": [["SSL/TLS", ""], ["FTP", ""], ["ARP", ""], ["NAT", ""]], "ans": 0, "exp": ["HTTPS = HTTP over SSL/TLS — the TLS layer encrypts the HTTP traffic (port 443). | Nukta: HTTPS = HTTP + SSL/TLS (443). HTTP = 80 (no encryption). FTP = 21. ARP = IP→MAC. NAT = address translation.", "HTTPS = HTTP over SSL/TLS — TLS layer HTTP traffic को encrypt करता है (port 443)। | HTTPS = HTTP + SSL/TLS (443)। HTTP = 80 (encryption नहीं)। FTP = 21। ARP = IP→MAC। NAT = address translation।"], "src": "Repo: CN Topic Test 5 (UNIT TEST-5)", "sec": "Section C — Firewalls, IPSec & Security Protocols", "diff": "medium", "stype": "repository_internal", "style": "concept", "tags": ["RSMSSB Informatics Assistant", "SSC Computer Awareness", "RPSC Programmer"]}, {"q": ["In which layer of the network architecture is the Secure Socket Layer (SSL) used?", "Secure Socket Layer (SSL) network architecture की किस layer में उपयोग होती है?"], "opts": [["Physical layer", ""], ["Session layer", ""], ["Application layer", ""], ["Presentation layer", ""]], "ans": 1, "exp": ["Exam banks place SSL at the Session layer — it establishes a secure session between application and transport (technically it sits between L4 and L7). | Nukta: Exam convention: SSL = Session layer (secure session setup + negotiation). Note: TLS = successor of SSL.", "Exam banks SSL को Session layer पर रखते हैं — यह application और transport के बीच secure session बनाती है (तकनीकी रूप से यह L4 और L7 के बीच है)। | Exam convention: SSL = Session layer (secure session setup + negotiation)। नोट: TLS, SSL का उत्तराधिकारी है।"], "src": "Unit Test-4 Solution (OCR), p6 (bank key)", "sec": "Section C — Firewalls, IPSec & Security Protocols", "diff": "medium", "stype": "repository_internal", "style": "concept", "tags": ["RSMSSB Informatics Assistant", "SSC Computer Awareness", "RPSC Programmer"]}, {"q": ["When a logic bomb is activated by a time-related event, it is known as a:", "जब कोई logic bomb किसी समय-संबंधी घटना से सक्रिय होता है, तो उसे कहते हैं:"], "opts": [["Time-related bomb sequence", ""], ["Virus", ""], ["Time bomb", ""], ["Trojan horse", ""]], "ans": 2, "exp": ["A logic bomb driven by date/time is a Time bomb (like the Friday-13 virus). | Nukta: Logic bomb = code that explodes on a condition; if the condition is time, it is a Time bomb.", "समय/तारीख़ से चलने वाला logic bomb = Time bomb (जैसे शुक्रवार-13 वायरस). | Logic bomb = शर्त से फटने वाला कोड; शर्त समय हो तो Time bomb."], "src": "SBI PO Computer Awareness PYQ (via bankersadda)", "sec": "Section C — Firewalls, IPSec & Security Protocols", "diff": "medium", "stype": "claimed_pyq_unverified", "style": "concept", "tags": ["IBPS Computer Awareness"]}, {"q": ["Verification based on a login ID and password is called:", "Login ID और password के आधार पर जाँच कहलाती है:"], "opts": [["Logging in", ""], ["Configuration", ""], ["Authentication", ""], ["Confidentiality", ""]], "ans": 2, "exp": ["Checking identity (ID + password) = Authentication. This is the first door of security. | Nukta: Authentication = 'तुम कौन हो?'; Authorization = 'तुम्हें क्या अनुमति है?'.", "पहचान (ID+password) की जाँच = Authentication. यही सुरक्षा का पहला दरवाज़ा है. | Authentication = 'तुम कौन हो?'; Authorization = 'तुम्हें क्या अनुमति है?'."], "src": "RBI/IBPS computer-awareness banks (via ixambee)", "sec": "Section C — Firewalls, IPSec & Security Protocols", "diff": "medium", "stype": "claimed_pyq_unverified", "style": "concept", "tags": ["IBPS Computer Awareness"]}, {"q": ["Access control based on a person's fingerprints is an example of:", "किसी व्यक्ति की उंगलियों के निशान पर आधारित access control का उदाहरण है:"], "opts": [["Biometric identification", ""], ["Characteristic identification", ""], ["Encryption", ""], ["Logistics", ""]], "ans": 0, "exp": ["Fingerprints, iris, face — these are all biometric identification. | Nukta: Physical identity (biometric) is stronger than something known (password).", "उंगली-छाप, आँख की पुतली, चेहरा — ये सब biometric identification हैं. | ज्ञात (password) से बढ़कर है शारीरिक पहचान (biometric)."], "src": "SBI PO Computer Awareness PYQ (via bankersadda)", "sec": "Section C — Firewalls, IPSec & Security Protocols", "diff": "medium", "stype": "claimed_pyq_unverified", "style": "concept", "tags": ["IBPS Computer Awareness"]}, {"q": ["Which one of the following is a key function of a firewall?", "निम्न में से firewall का एक मुख्य काम कौन-सा है?"], "opts": [["Monitoring", ""], ["Copying", ""], ["Deleting", ""], ["Moving", ""]], "ans": 0, "exp": ["Firewall आने-जाने वाले traffic की monitoring करता है और अनधिकृत पहुँच को रोकता है. | Nukta: BPSC 2024 official key (a). VPN = a private limousine on the public road.", "Firewall आने-जाने वाले traffic की monitoring करता है और अनधिकृत पहुँच को रोकता है. | Firewall = network का चौकीदार — देखता है, जाँचता है, रोकता है."], "src": "RRB NTPC previous-year computer banks (via adda247 50-PYQ PDF)", "sec": "Section C — Firewalls, IPSec & Security Protocols", "diff": "medium", "stype": "claimed_pyq_unverified", "style": "concept", "tags": ["RRB Computer Awareness"]}, {"q": ["In IPSec tunnel mode, which parts of the original packet are encrypted?", "IPSec tunnel mode में original packet के कौन-से भाग encrypt होते हैं?"], "opts": [["Only the header", "केवल header"], ["Only the payload", "केवल payload"], ["The whole original packet", "पूरा original packet"], ["Nothing", "कुछ नहीं"]], "ans": 2, "exp": ["Tunnel mode = poora original packet encrypt + naya header (VPN). | Nukta: Transport mode mein sirf payload.", "Tunnel mode = पूरा packet (VPN)। | Transport mode में सिर्फ़ payload।"], "src": "Practice — original (textbook-based)", "sec": "Section C — Firewalls, IPSec & Security Protocols", "diff": "medium", "stype": "original_practice", "style": "concept", "tags": ["RSMSSB Informatics Assistant", "SSC Computer Awareness", "RPSC Programmer", "Practice Set"]}, {"q": ["SSL/TLS works at which layer?", "SSL/TLS किस layer पर काम करता है?"], "opts": [["Network", "Network"], ["Transport (between transport and application)", "Transport"], ["Physical", "Physical"], ["Data link", "Data link"]], "ans": 1, "exp": ["SSL/TLS transport ke upar, application ke neeche. | Nukta: IPSec network layer.", "SSL/TLS transport के ऊपर। | IPSec network layer।"], "src": "Practice — original (textbook-based)", "sec": "Section C — Firewalls, IPSec & Security Protocols", "diff": "medium", "stype": "original_practice", "style": "concept", "tags": ["RSMSSB Informatics Assistant", "SSC Computer Awareness", "RPSC Programmer", "Practice Set"]}, {"q": ["A VPN creates:", "VPN बनाता है:"], "opts": [["A private tunnel over a public network", "Public network पर private tunnel"], ["A new physical cable", "नई physical cable"], ["A virus filter", "Virus filter"], ["A new protocol", "नया protocol"]], "ans": 0, "exp": ["VPN = encryption ke saath private tunnel (IPSec/PPTP). | Nukta: Firewall filter karta hai.", "VPN = encrypted private tunnel। | Firewall filter करता है।"], "src": "Practice — original (textbook-based)", "sec": "Section C — Firewalls, IPSec & Security Protocols", "diff": "medium", "stype": "original_practice", "style": "concept", "tags": ["RSMSSB Informatics Assistant", "SSC Computer Awareness", "RPSC Programmer", "Practice Set"]}, {"q": ["Which wireless security standard is the strongest among these?", "इनमें से कौन-सी wireless security standard सबसे मज़बूत है?"], "opts": [["WEP", "WEP"], ["WPA", "WPA"], ["WPA2", "WPA2"], ["Open", "Open"]], "ans": 2, "exp": ["WPA2 (AES) > WPA > WEP > open. | Nukta: WEP bahut kamzor.", "WPA2 (AES) > WPA > WEP > open। | WEP बहुत कमज़ोर।"], "src": "Practice — original (textbook-based)", "sec": "Section C — Firewalls, IPSec & Security Protocols", "diff": "medium", "stype": "original_practice", "style": "concept", "tags": ["RSMSSB Informatics Assistant", "SSC Computer Awareness", "RPSC Programmer", "Practice Set"]}, {"q": ["PGP (Pretty Good Privacy) is used for:", "PGP प्रयोग होता है:"], "opts": [["Secure e-mail", "सुरक्षित e-mail"], ["Routing", "Routing"], ["Cable testing", "Cable testing"], ["Address resolution", "Address resolution"]], "ans": 0, "exp": ["PGP e-mail encryption + digital signature. | Nukta: Routing routing protocols का काम।", "PGP e-mail encryption + signature। | Routing protocols का काम।"], "src": "Practice — original (textbook-based)", "sec": "Section C — Firewalls, IPSec & Security Protocols", "diff": "medium", "stype": "original_practice", "style": "concept", "tags": ["RSMSSB Informatics Assistant", "SSC Computer Awareness", "RPSC Programmer", "Practice Set"]}, {"q": ["Which IPSec protocol provides encryption (confidentiality) of the packet data?", "IPSec का कौन-सा protocol packet data की encryption (confidentiality) देता है?"], "opts": [["ESP", "ESP"], ["AH", "AH"], ["IKE", "IKE"], ["HMAC", "HMAC"]], "ans": 0, "exp": ["ESP (Encapsulating Security Payload) = encryption + integrity + optional authentication; AH = authentication + integrity, encryption nahi. | Nukta: IKE = key exchange ka protocol; HMAC = message authentication code.", "ESP = encryption + integrity; AH = authentication + integrity, encryption नहीं। | IKE = key exchange; HMAC = authentication code।"], "src": "Practice — original (textbook-based)", "sec": "Section C — Firewalls, IPSec & Security Protocols", "diff": "medium", "stype": "original_practice", "style": "concept", "tags": ["RSMSSB Informatics Assistant", "SSC Computer Awareness", "RPSC Programmer", "Practice Set"]}, {"q": ["In which IPSec mode is the original IP header encrypted together with the payload (as used in VPNs)?", "IPSec की किस mode में मूल IP header भी payload के साथ encrypt होता है (जैसे VPN में)?"], "opts": [["Tunnel mode", "Tunnel mode"], ["Transport mode", "Transport mode"], ["Transparent mode", "Transparent mode"], ["Stealth mode", "Stealth mode"]], "ans": 0, "exp": ["Tunnel mode = pura original packet encapsulate + encrypt, naya outer header lagta hai — site-to-site VPNs isi par chalti hain. Transport mode mein sirf payload encrypt hota hai, original header khula. | Nukta: Transport mode = host-to-host security (jaise IPsec ke andar TLS jaisa use).", "Tunnel mode = पूरा packet encapsulate + encrypt, नया outer header; VPN इसी में। Transport mode में सिर्फ payload encrypt। | Transport mode = host-to-host security।"], "src": "Practice — original (textbook-based)", "sec": "Section C — Firewalls, IPSec & Security Protocols", "diff": "medium", "stype": "original_practice", "style": "concept", "tags": ["RSMSSB Informatics Assistant", "SSC Computer Awareness", "RPSC Programmer", "Practice Set"]}, {"q": ["Which wireless security standard uses AES-CCMP encryption (the replacement for the weaker WEP/TKIP)?", "कौन-सी wireless security standard AES-CCMP encryption प्रयोग करती है (कमज़ोर WEP/TKIP की जगह)?"], "opts": [["WPA2", "WPA2"], ["WEP", "WEP"], ["WPA", "WPA"], ["Open authentication", "Open authentication"]], "ans": 0, "exp": ["WPA2 (802.11i) = AES-CCMP encryption; WEP = RC4 (tuta hua); WPA = TKIP (temporary). WPA3 ab SAE + AES-GCMP. Pattern: SSC CGL/IBPS + Network+. | Nukta: Wireless security ka evolution: WEP → WPA → WPA2 → WPA3.", "WPA2 = AES-CCMP; WEP = RC4 (टूटा); WPA = TKIP; WPA3 = SAE। Pattern: SSC CGL + Network+। | Wireless security: WEP → WPA → WPA2 → WPA3।"], "src": "Practice — original (SSC CGL/IBPS exam-pattern, textbook-based)", "sec": "Section C — Firewalls, IPSec & Security Protocols", "diff": "medium", "stype": "original_practice", "style": "concept", "tags": ["SSC Computer Awareness", "Practice Set"]}, {"q": ["Fragmentation has following demerits", ""], "opts": [["complicates routers", ""], ["open to DOS attack", ""], ["overlapping of fragments", ""], ["All of the mentioned", ""]], "ans": 3, "exp": ["Nukta: ⚠ CAUTION — answer NOT verified: compiled-bank source key = (D). Please verify before relying.", "⚠ सावधान — उत्तर verify नहीं है: source key = (D)। कृपया उपयोग से पहले स्वयं जाँच कर लें।"], "src": "Repo: DCN_MCQ-Ashwini-.pdf (new/ 2026 drop)", "sec": "Section C — Firewalls, IPSec & Security Protocols", "diff": "hard", "stype": "repository_internal", "style": "concept", "tags": ["GATE CS", "UGC-NET 087", "RPSC Programmer", "RPSC ACP/DD"]}, {"q": ["The DoS attack is which the attacker establishes a large number of half-open or fully open TCP connections at the target host", ""], "opts": [["Vulnerability attack", ""], ["Bandwidth flooding", ""], ["Connection flooding", ""], ["All of the mentioned", ""]], "ans": 2, "exp": ["Nukta: ⚠ CAUTION — answer NOT verified: compiled-bank source key = (C). Please verify before relying.", "⚠ सावधान — उत्तर verify नहीं है: source key = (C)। कृपया उपयोग से पहले स्वयं जाँच कर लें।"], "src": "Repo: DCN_MCQ-Ashwini-.pdf (new/ 2026 drop)", "sec": "Section C — Firewalls, IPSec & Security Protocols", "diff": "hard", "stype": "repository_internal", "style": "concept", "tags": ["GATE CS", "UGC-NET 087", "RPSC Programmer", "RPSC ACP/DD"]}, {"q": ["What is Wired Equivalent Privacy (WEP) ?", ""], "opts": [["security algorithm for ethernet", ""], ["security algorithm for wireless networks", ""], ["security algorithm for 