  <div class="resWrap">
    <h2 style="font-size:18px; color:#16283f; border-bottom:2.5px solid #E97313; display:inline-block; padding-bottom:5px; margin-bottom:10px;">Result &amp; Analysis</h2>
    <div class="resTitle" id="resTitle"></div>
